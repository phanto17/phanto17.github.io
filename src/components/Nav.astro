---
import { site, PROJECTS_INDEX, mapHrefFor } from '../data/site';
import { LANDMARKS, NAV } from '../data/locations';

interface Props {
  /** This page's place on the map (a location id); the Map link opens it. */
  location?: string;
}
const { location } = Astro.props;
/**
 * The overview sections the scroll-spy follows: the nav link each one lights and the place on the map
 * the Map link points at while it is in view. Rendered as data, so the script needs no location list.
 */
const spySections = [
  ...LANDMARKS.map((l) => ({ id: l.href.split('#')[1], nav: l.href, map: l.mapHref })),
  { id: 'projects', nav: PROJECTS_INDEX, map: mapHrefFor(null) },
];
---

<!-- The nav persists across client-side page navigations: its state and listeners survive the swap. -->
<nav class="nav" aria-label="Main" transition:persist="site-nav" data-spy-sections={JSON.stringify(spySections)}>
  <div class="wrap bar">
    <a class="brand" href="/">{site.name} <em>— field notes</em></a>
    <ul id="nav-links" class="nav-list">
      {NAV.map((item, i) => (
        <li>
          {i === 0 ? (
            <a href={mapHrefFor(location)} data-nav-link={item.href} data-nav-map>{item.label}</a>
          ) : (
            <a href={item.href} data-nav-link={item.href}>{item.label}</a>
          )}
        </li>
      ))}
      <li class="mobile-motion">
        <button type="button" class="btn hud-key util-btn" data-motion-switcher aria-pressed="true">
          <span data-motion-label>Motion: ON</span>
        </button>
      </li>
    </ul>
    <div class="nav-actions">
      <button
        type="button"
        id="theme-switcher"
        class="btn hud-key util-btn"
        aria-label="Cycle visual theme (Prism Darkroom, Daylight Paper, CRT Terminal)"
        title="Switch Theme: Prism / Paper / CRT"
      >
        <span class="util-dot" aria-hidden="true">◐</span>
        <span id="theme-label">Prism</span>
      </button>
      <button
        type="button"
        id="motion-switcher"
        data-motion-switcher
        class="btn hud-key util-btn"
        aria-pressed="true"
        aria-label="Toggle kinetic animations and motion effects"
        title="Toggle Motion (Full / Reduced)"
      >
        <span data-motion-label>Motion: ON</span>
      </button>
      <button
        type="button"
        class="btn hud-key menu-toggle"
        aria-expanded="false"
        aria-controls="nav-links"
        aria-label="Toggle navigation menu"
      >
        <span class="menu-icon" aria-hidden="true">☰</span>
        <span class="menu-text">Menu</span>
      </button>
      <a class="btn hud-key cv" href={site.cv} download data-astro-prefetch="false">
        <span class="long">Download CV</span><span class="short">CV</span>
      </a>
    </div>
  </div>
</nav>

<script>
  import type { ThemeId } from '../scripts/generated/themes';
  import { onPage } from '../scripts/page';
  import { prefs } from '../scripts/prefs';
  import { OVERVIEW, PROJECTS_INDEX, mapHrefFor } from '../data/site';
  import { MEDIA } from '../scripts/generated/breakpoints';

  const root = document.documentElement;
  root.classList.add('js-nav');
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const list = document.querySelector<HTMLUListElement>('#nav-links');
  const navEl = document.querySelector<HTMLElement>('.nav');
  const themeBtn = document.querySelector<HTMLButtonElement>('#theme-switcher');
  const themeLabel = document.querySelector<HTMLElement>('#theme-label');
  const motionButtons = document.querySelectorAll<HTMLButtonElement>('[data-motion-switcher]');
  const motionLabels = document.querySelectorAll<HTMLElement>('[data-motion-label]');

  // 1. Theme key: Prism -> Paper -> CRT, and -> Signal once the visitor has cleared Telegraph Recall in
  // this browser. The cycle, the storage and the browser chrome colour belong to src/scripts/prefs.ts;
  // this key only presents them.
  const themeNames: Record<ThemeId, string> = {
    prism: 'Prism',
    paper: 'Paper',
    crt: 'CRT',
    signal: 'Signal',
  };

  const syncThemeUi = () => {
    const cur = prefs.currentTheme();
    if (themeLabel) themeLabel.textContent = themeNames[cur];
    themeBtn?.setAttribute('aria-label', `Current theme: ${themeNames[cur]}. Change theme`);
  };
  syncThemeUi();
  // Also fired when the OS scheme moves while no theme is saved.
  prefs.onChange('theme', syncThemeUi);

  /**
   * A theme change is a CRT power-cycle: surfaces and text cross-fade for one lift duration while
   * the page flickers once (360ms), both skipped under reduced motion.
   */
  let flickerTimer: number | null = null;
  let switchTimer: number | null = null;
  const flickerTheme = () => {
    if (!prefs.isMotionAllowed()) return;
    root.classList.add('is-theme-switching');
    root.classList.remove('is-theme-flicker');
    void root.offsetWidth;
    root.classList.add('is-theme-flicker');
    if (flickerTimer !== null) window.clearTimeout(flickerTimer);
    if (switchTimer !== null) window.clearTimeout(switchTimer);
    flickerTimer = window.setTimeout(() => root.classList.remove('is-theme-flicker'), 400);
    switchTimer = window.setTimeout(() => root.classList.remove('is-theme-switching'), 320);
  };

  themeBtn?.addEventListener('click', () => {
    flickerTheme();
    prefs.set('theme', prefs.nextTheme());
  });

  // 2. Motion key (Full vs Reduced), disabled while the OS itself asks for reduced motion.
  const syncMotionUi = () => {
    const system = prefs.systemReducedMotion();
    const isReduced = !prefs.isMotionAllowed();
    motionButtons.forEach((button) => {
      button.setAttribute('aria-pressed', String(!isReduced));
      button.disabled = system;
      button.title = system ? 'Reduced motion is enabled in your system settings' : 'Toggle motion';
    });
    motionLabels.forEach((label) => {
      label.textContent = system ? 'Motion: system reduced' : isReduced ? 'Motion: OFF' : 'Motion: ON';
    });
  };
  syncMotionUi();
  prefs.onChange('motion', syncMotionUi);
  motionButtons.forEach((button) =>
    button.addEventListener('click', () => {
      prefs.set('motion', prefs.get('motion') === 'reduced' ? 'full' : 'reduced');
    }),
  );

  // 3. Mobile Drawer
  if (toggle && list) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      list.classList.toggle('open', open);
      const icon = toggle.querySelector('.menu-icon');
      if (icon) icon.textContent = open ? '✕' : '☰';
    };

    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      setOpen(!expanded);
    });

    list.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('click', (e) => {
      if (toggle.getAttribute('aria-expanded') === 'true' && navEl && !navEl.contains(e.target as Node)) {
        setOpen(false);
      }
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    window.matchMedia(MEDIA.belowWide).addEventListener('change', () => setOpen(false));
    document.addEventListener('astro:after-swap', () => setOpen(false));
  }

  // 4. Where the visitor is. The Map link always points at this page's place on the map (body
  // data-location, set by Base from the page's location), or at the place of the overview section in
  // view; Projects is current on the index and on every write-up; the scroll-spy lights the overview
  // section in view; on the map, Map is current.
  interface SpySection { id: string; nav: string; map: string }
  const spySections: SpySection[] = JSON.parse(navEl?.dataset.spySections ?? '[]');
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));
  const mapLink = document.querySelector<HTMLAnchorElement>('[data-nav-map]');
  const mark = (current: (link: HTMLAnchorElement) => 'page' | 'location' | null) =>
    links.forEach((l) => {
      const state = current(l);
      l.classList.toggle('active', state !== null);
      if (state) l.setAttribute('aria-current', state);
      else l.removeAttribute('aria-current');
    });
  const navHref = (l: HTMLAnchorElement) => l.dataset.navLink ?? '';
  let spy: IntersectionObserver | null = null;
  const armScrollSpy = () => {
    spy?.disconnect();
    spy = null;
    const path = window.location.pathname;
    const onMap = path === '/' || path === '/index.html';
    const onOverview = path === OVERVIEW || path === `${OVERVIEW}index.html`;
    const onProjects = path.startsWith(PROJECTS_INDEX);
    if (mapLink) mapLink.href = mapHrefFor(document.body.dataset.location);
    if (!onOverview) {
      mark((l) => {
        if (onMap && navHref(l) === '/') return 'page';
        if (onProjects && navHref(l) === PROJECTS_INDEX) return path === PROJECTS_INDEX ? 'page' : 'location';
        return null;
      });
      return;
    }
    mark(() => null);
    const sections = spySections
      .map((sec) => ({ sec, el: document.getElementById(sec.id) }))
      .filter((x): x is { sec: SpySection; el: HTMLElement } => Boolean(x.el));
    if (!('IntersectionObserver' in window) || sections.length === 0) return;
    spy = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const hit = sections.find((x) => x.el === entry.target)?.sec;
          if (!hit) return;
          mark((l) => (navHref(l) === hit.nav ? 'location' : null));
          if (mapLink) mapLink.href = hit.map;
        });
      },
      { rootMargin: '-30% 0px -55% 0px', threshold: 0 },
    );
    sections.forEach((x) => spy?.observe(x.el));
  };
  onPage(armScrollSpy);
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--panel);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: var(--line);
  }
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 68px;
    gap: 12px;
  }
  .brand {
    font-family: var(--display);
    font-size: 20px;
    font-weight: 600;
    font-variation-settings: var(--soft);
    letter-spacing: -0.01em;
    color: var(--text);
    white-space: nowrap;
  }
  .brand:hover {
    color: var(--peach);
  }
  .brand em {
    font-style: italic;
    font-weight: 400;
    color: var(--text-2);
  }
  .nav-list {
    list-style: none;
    display: flex;
    gap: 22px;
    margin: 0;
    padding: 0;
    font-size: 15px;
  }
  .nav-list a {
    color: var(--text-2);
    padding: 4px 2px;
    border-bottom: 2px solid transparent;
    transition: color 0.2s, border-color 0.2s;
  }
  .nav-list a:hover,
  .nav-list a.active {
    color: var(--text);
  }
  .nav-list a.active {
    border-bottom-color: var(--coral);
    color: var(--gold);
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .util-btn {
    gap: 5px;
  }
  .util-dot {
    color: var(--coral);
    font-size: 12px;
  }
  .menu-toggle {
    display: none;
    gap: 6px;
  }
  .mobile-motion {
    display: none;
  }
  :global(html:not(.js-nav)) #theme-switcher,
  :global(html:not(.js-nav)) #motion-switcher {
    display: none;
  }
  .cv {
    padding-inline: 12px;
  }
  .cv .short {
    display: none;
  }
  @media (max-width: 980px) {
    #motion-switcher {
      display: none;
    }
  }
  @media (max-width: 980px) {
    .nav-actions .btn,
    .mobile-motion .btn { min-width: 44px; min-height: 44px; justify-content: center; }
    :global(html.js-nav) .menu-toggle {
      display: inline-flex;
    }
    .nav-list {
      display: flex;
      position: absolute;
      top: 68px;
      left: 0;
      right: 0;
      max-height: calc(100dvh - 68px);
      overflow-y: auto;
      flex-direction: column;
      gap: 0;
      background: var(--surface);
      border-bottom: var(--line);
      padding: 8px 20px 16px;
      box-shadow: 0 18px 36px rgba(0, 0, 0, 0.65);
    }
    :global(html.js-nav) .nav-list {
      display: none;
    }
    :global(html.js-nav) .nav-list.open {
      display: flex;
    }
    .nav-list li {
      margin: 0;
    }
    .mobile-motion {
      display: none;
      padding-top: 12px;
    }
    :global(html.js-nav) .mobile-motion {
      display: block;
    }
    .nav-list li a {
      display: block;
      padding: 12px 4px;
      border-bottom: var(--line);
    }
    .nav-list li:last-child a {
      border-bottom: none;
    }
    .brand em {
      display: none;
    }
    .cv .long {
      display: none;
    }
    .cv .short {
      display: inline;
    }
  }
  @media (max-width: 980px) {
    :global(html:not(.js-nav)) .nav { position: static; }
    :global(html:not(.js-nav)) .bar { height: auto; min-height: 68px; flex-wrap: wrap; }
    :global(html:not(.js-nav)) .nav-list {
      position: static;
      order: 3;
      width: 100%;
      max-height: none;
      box-shadow: none;
      padding: 0 0 12px;
    }
    :global(html:not(.js-nav)) .nav-actions { order: 2; }
    :global(html:not(.js-nav)) #theme-switcher { display: none; }
  }
  @media (max-width: 420px) {
    .brand { font-size: 14px; }
    .bar { gap: 6px; }
    .nav-actions { gap: 4px; }
    .util-btn, .menu-toggle, .cv { padding-inline: 7px; }
    #theme-label { display: none; }
    .menu-text { display: none; }
  }
</style>

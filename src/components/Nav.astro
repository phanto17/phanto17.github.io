---
import { NAV } from '../data/locations';
import { PROJECTS_INDEX, site } from '../data/site';

const pathname = Astro.url.pathname;
const isCurrent = (href: string) => {
  if (href === '/') return pathname === '/';
  if (href === PROJECTS_INDEX) return pathname.startsWith(PROJECTS_INDEX);
  return false;
};
---

<header class="ac-nav" id="site-nav">
  <nav class="ac-nav-inner" aria-label="Primary">
    <a class="ac-brand" href="/">
      <span class="ac-brand-mark" aria-hidden="true">◆</span>
      <span>{site.name}</span>
    </a>

    <ul id="nav-links" class="ac-nav-links">
      {
        NAV.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              data-nav-href={item.href}
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="ac-mobile-cv">
        <a href={site.cv} download>↓ Download CV (PDF)</a>
      </li>
    </ul>

    <div class="ac-nav-actions">
      <a class="ac-nav-ext" href={site.github} target="_blank" rel="noopener">GitHub ↗</a>
      <a class="ac-nav-ext" href={site.itch} target="_blank" rel="noopener">itch.io ↗</a>

      <button
        id="theme-switcher"
        type="button"
        class="ac-pref-btn"
        aria-label="Cycle colour theme"
        title="Cycle colour theme"
      >
        <span data-theme-label>Prism</span>
      </button>

      <button
        id="motion-switcher"
        type="button"
        class="ac-pref-btn"
        aria-pressed="true"
        aria-label="Toggle animations"
        title="Toggle animations"
      >
        <span data-motion-label>Motion: On</span>
      </button>

      <a class="ac-nav-cv" href={site.cv} download>↓ CV</a>

      <button
        id="nav-toggle"
        type="button"
        class="ac-menu-toggle"
        aria-controls="nav-links"
        aria-expanded="false"
      >
        Menu
      </button>
    </div>
  </nav>
</header>

<style>
  .ac-mobile-cv {
    display: none;
  }

  :global(html:not(.js-nav)) #theme-switcher,
  :global(html:not(.js-nav)) #motion-switcher {
    display: none;
  }

  @media (max-width: 980px) {
    .ac-mobile-cv {
      display: block;
      margin-top: 6px;
      padding-top: 6px;
      border-top: 1px solid var(--hairline);
    }
  }
</style>

<script>
  import { MEDIA } from '../scripts/generated/breakpoints';
  import { THEME_BG, type ThemeId } from '../scripts/generated/themes';
  import { onPage } from '../scripts/page';
  import { prefs } from '../scripts/prefs';

  const THEME_NAMES: Record<ThemeId, string> = {
    prism: 'Prism',
    paper: 'Paper',
    crt: 'CRT',
    signal: 'Signal',
  };

  onPage(({ signal }) => {
    document.documentElement.classList.add('js-nav');
    const navEl = document.getElementById('site-nav');
    const toggle = document.getElementById('nav-toggle') as HTMLButtonElement | null;
    const themeBtn = document.getElementById('theme-switcher') as HTMLButtonElement | null;
    const themeLabel = themeBtn?.querySelector<HTMLElement>('[data-theme-label]');
    const motionBtn = document.getElementById('motion-switcher') as HTMLButtonElement | null;
    const motionLabel = motionBtn?.querySelector<HTMLElement>('[data-motion-label]');
    const linksWrap = document.getElementById('nav-links');

    const syncTheme = () => {
      const cur = prefs.currentTheme();
      if (themeLabel) themeLabel.textContent = THEME_NAMES[cur] ?? cur;
      const meta = document.getElementById('theme-color');
      if (meta && THEME_BG[cur]) meta.setAttribute('content', THEME_BG[cur]);
    };

    const syncMotion = () => {
      const osReduced = prefs.systemReducedMotion();
      const allowed = prefs.isMotionAllowed();
      if (motionBtn) {
        motionBtn.setAttribute('aria-pressed', String(allowed));
        motionBtn.disabled = osReduced;
        motionBtn.title = osReduced
          ? 'Animations disabled by your OS reduced-motion setting'
          : 'Toggle animations';
      }
      if (motionLabel) {
        motionLabel.textContent = osReduced ? 'Motion: OS' : allowed ? 'Motion: On' : 'Motion: Off';
      }
    };

    syncTheme();
    syncMotion();

    prefs.onChange('theme', syncTheme, { signal });
    prefs.onChange('motion', syncMotion, { signal });

    themeBtn?.addEventListener(
      'click',
      () => {
        prefs.set('theme', prefs.nextTheme());
      },
      { signal },
    );

    motionBtn?.addEventListener(
      'click',
      () => {
        const currentlyAllowed = prefs.isMotionAllowed();
        prefs.set('motion', currentlyAllowed ? 'reduced' : 'full');
      },
      { signal },
    );

    const setOpen = (open: boolean) => {
      if (!navEl || !toggle) return;
      navEl.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };

    toggle?.addEventListener(
      'click',
      () => {
        const isOpen = toggle.getAttribute('aria-expanded') === 'true';
        setOpen(!isOpen);
      },
      { signal },
    );

    linksWrap?.addEventListener(
      'click',
      (e) => {
        if ((e.target as HTMLElement | null)?.closest('a')) setOpen(false);
      },
      { signal },
    );

    document.addEventListener(
      'click',
      (e) => {
        if (toggle?.getAttribute('aria-expanded') === 'true' && navEl && !navEl.contains(e.target as Node)) {
          setOpen(false);
        }
      },
      { signal },
    );

    document.addEventListener(
      'keydown',
      (e) => {
        if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
          setOpen(false);
          toggle.focus();
        }
      },
      { signal },
    );

    const mq = window.matchMedia(MEDIA.belowWide);
    const onMq = () => {
      if (!mq.matches) setOpen(false);
    };
    mq.addEventListener('change', onMq);
    signal.addEventListener('abort', () => mq.removeEventListener('change', onMq));

    // Scroll-spy for home hash nav links while staying compatible with multipage routes.
    const path = window.location.pathname;
    const isHome = path === '/' || path === '/index.html';
    if (isHome) {
      const anchors = Array.from(document.querySelectorAll<HTMLAnchorElement>('#nav-links a[data-nav-href]'));
      const hashPairs = anchors
        .map((a) => {
          const href = a.dataset.navHref ?? '';
          if (!href.startsWith('/#')) return null;
          const el = document.getElementById(href.slice(2));
          return el ? { a, el } : null;
        })
        .filter((x): x is { a: HTMLAnchorElement; el: HTMLElement } => x !== null);

      const homeLink = anchors.find((a) => a.dataset.navHref === '/');

      const syncSpy = () => {
        const y = window.scrollY;
        const trigger = y + 150;
        let currentHashAnchor: HTMLAnchorElement | null = null;
        for (const pair of hashPairs) {
          const top = pair.el.getBoundingClientRect().top + y;
          if (top <= trigger) currentHashAnchor = pair.a;
        }
        for (const pair of hashPairs) {
          pair.a.classList.toggle('is-active', pair.a === currentHashAnchor);
        }
        if (homeLink) {
          if (currentHashAnchor) homeLink.removeAttribute('aria-current');
          else homeLink.setAttribute('aria-current', 'page');
        }
      };

      syncSpy();
      window.addEventListener('scroll', syncSpy, { passive: true, signal });
    }
  });
</script>

---
/**
 * The CRT window bar over a CRT card: a mono label on the left ("[■] CONTACT // TTY_01") and a status
 * readout on the right ("● ONLINE"). Decorative; the card's own text carries the meaning. Since the
 * project cards became map labels (P3, P4) its one use is the overview's contact terminal (D5).
 */
interface Props {
  label: string;
  status: string;
}
const { label, status } = Astro.props;
---

<div class="crt-win-bar" aria-hidden="true">
  <span>{label}</span>
  <span class="win-status">● {status}</span>
</div>

<style>
  .crt-win-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 18px;
    background: var(--surface-2);
    border-bottom: 1px solid var(--umber);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--steel);
  }
  .win-status {
    color: var(--mint);
  }
</style>

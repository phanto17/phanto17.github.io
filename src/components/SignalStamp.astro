---
/**
 * Clear-the-signal stamp (R3): "SIGNAL CLEARED · <best score>" in the hero, a glass key that cannot
 * be pressed with the hard umber offset of the cards. Shown only in a browser where Telegraph Recall
 * has been cleared (html.has-signal, set by the head script before first paint so nothing shifts, and
 * by the game itself on the clear). Without JavaScript it stays hidden.
 */
---

<p id="signal-stamp" class="signal-stamp key" aria-label="Signal cleared.">
  <span class="signal-stamp-dot" aria-hidden="true"></span>
  <span class="signal-stamp-text">SIGNAL CLEARED · <b id="signal-stamp-score">—</b></span>
</p>

<script>
  import { readReward, type SignalReward } from '../scripts/signal-reward';
  import { prefs } from '../scripts/prefs';

  const root = document.documentElement;
  const isMotionAllowed = () => prefs.isMotionAllowed();

  document.addEventListener('astro:page-load', () => {
    const stamp = document.getElementById('signal-stamp');
    const score = document.getElementById('signal-stamp-score');
    if (!stamp || !score) return;

    const sync = (reward: SignalReward) => {
      score.textContent = String(reward.best);
      stamp.setAttribute('aria-label', `Signal cleared. Best score ${reward.best}.`);
      prefs.refreshSignal();
    };

    let storage: Storage | null = null;
    try {
      storage = localStorage;
    } catch {
      storage = null;
    }
    const reward = readReward(storage);
    if (reward) sync(reward);
    else prefs.refreshSignal();

    const page = new AbortController();
    window.addEventListener(
      'portfolio:signalcleared',
      (event) => {
        const detail = (event as CustomEvent<{ reward: SignalReward }>).detail;
        if (!detail?.reward) return;
        const wasHidden = !root.classList.contains('has-signal');
        sync(detail.reward);
        if (wasHidden && isMotionAllowed()) {
          stamp.classList.remove('is-new');
          void stamp.offsetWidth;
          stamp.classList.add('is-new');
        }
      },
      { signal: page.signal },
    );
    document.addEventListener('astro:before-swap', () => page.abort(), { once: true, signal: page.signal });
  });
</script>

<style>
  .signal-stamp {
    --key-radius: var(--r-xs);
    display: none;
    align-items: center;
    gap: 9px;
    width: max-content;
    max-width: 100%;
    margin: 0 0 8px;
    padding: 7px 13px 7px 11px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
    pointer-events: none;
    user-select: none;
    transform-origin: left center;
    /* The glass dome from .key, plus the hard umber offset the cards and notes carry. */
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.16),
      inset 0 -2px 0 rgba(0, 0, 0, 0.3),
      var(--btn-depth);
  }
  :global(html.has-signal) .signal-stamp {
    display: inline-flex;
  }
  .signal-stamp :global(b),
  .signal-stamp b {
    color: var(--text);
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  .signal-stamp-text {
    position: relative;
    z-index: 3;
  }
  .signal-stamp-dot {
    position: relative;
    z-index: 3;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: var(--glow-amber);
  }
  :global(html.js-motion) .signal-stamp-dot {
    animation: signal-stamp-pulse var(--pulse) ease-in-out infinite;
  }
  .signal-stamp.is-new {
    animation: signal-stamp-in 640ms var(--ease-out-expo) backwards;
  }
  @keyframes signal-stamp-pulse {
    50% {
      opacity: 0.45;
    }
  }
  @keyframes signal-stamp-in {
    from {
      opacity: 0;
      transform: scale(1.4) rotate(-4deg);
    }
    60% {
      opacity: 1;
      transform: scale(0.97) rotate(0.5deg);
    }
    to {
      transform: none;
    }
  }
</style>

---
import { getCollection } from 'astro:content';
import { site } from '../data/site';
import { buildLocations } from '../data/locations';
const year = new Date().getFullYear();
// The places the map's field log counts, so the status line reads the same "n/N explored".
const locationIds = buildLocations(await getCollection('projects')).map((l) => l.id);
---

<footer class="footer">
  <div class="wrap">
    <!-- The map's status line: the Poznań clock the map is lit by and the field log's count. Filled by
         the script below; without JavaScript it stays hidden and the links row is the footer. -->
    <p class="status" data-status-line data-locations={locationIds.join(' ')} hidden>
      <span>Poznań <span data-status-time></span></span>
      <span class="sep" aria-hidden="true">·</span>
      <span data-status-phase></span>
      <span class="sep" aria-hidden="true">·</span>
      <a href="/" data-status-explored></a>
      <span class="sep" aria-hidden="true">·</span>
      <a href="/style-guide/">Style guide</a>
    </p>
    <p class="links">
      <span>© {year} {site.name}</span>
      <span class="sep" aria-hidden="true">·</span>
      <a href={site.github}>GitHub</a>
      <span class="sep" aria-hidden="true">·</span>
      <a href={site.youtube}>YouTube</a>
      <span class="sep" aria-hidden="true">·</span>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <span class="sep no-js-only" aria-hidden="true">·</span>
      <a class="no-js-only" href="/style-guide/">Style guide</a>
      <span class="sep" aria-hidden="true">·</span>
      <span>built with Astro, hosted on GitHub Pages</span>
    </p>
  </div>
</footer>

<script>
  import { onPage } from '../scripts/page';
  import { poznanHour } from '../world/daylight';
  import { VISITED_KEY, parseVisited, statusLine } from '../lib/status-line';

  const TICK_MS = 30_000;

  onPage(({ signal }) => {
    const line = document.querySelector<HTMLElement>('[data-status-line]');
    if (!line) return;
    const ids = (line.dataset.locations ?? '').split(' ').filter(Boolean);
    const time = line.querySelector<HTMLElement>('[data-status-time]');
    const phase = line.querySelector<HTMLElement>('[data-status-phase]');
    const explored = line.querySelector<HTMLElement>('[data-status-explored]');
    const render = () => {
      let raw: string | null = null;
      try {
        raw = localStorage.getItem(VISITED_KEY);
      } catch {
        /* storage blocked: nothing explored */
      }
      const s = statusLine(poznanHour(), parseVisited(raw), ids);
      if (time) time.textContent = s.time;
      if (phase) phase.textContent = s.phase;
      if (explored) explored.textContent = s.explored;
    };
    render();
    line.hidden = false;
    document.documentElement.classList.add('has-status-line');
    const timer = window.setInterval(render, TICK_MS);
    signal.addEventListener('abort', () => window.clearInterval(timer));
  });
</script>

<style>
  .footer {
    padding: 40px 0 48px;
    font-size: 13px;
    color: var(--text-3);
    font-family: var(--mono);
    border-top: var(--line);
    position: relative;
    z-index: 1;
  }
  .footer .wrap {
    display: grid;
    gap: 10px;
  }
  .status,
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
  }
  .status {
    color: var(--text-2);
  }
  .status[hidden] {
    display: none;
  }
  :global(html.has-status-line) .no-js-only {
    display: none;
  }
  .sep {
    color: var(--umber);
  }
</style>

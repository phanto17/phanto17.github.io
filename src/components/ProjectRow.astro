---
/**
 * A row of the projects index: the map's label grown into a row (field-kit .tag — the location's
 * accent border and hard offset on the translucent ground). The eyebrow names the place
 * ("Location 03 · genre", the same line as the write-up's location bar); the diamond fills once the
 * visitor has explored it on the map (LocationMap's script). The row's id is the minimap's link target.
 */
import type { CollectionEntry } from 'astro:content';
import { projectView } from '../lib/project-view';
import Figure from './Figure.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  /** "Location 03 · 2D dungeon crawler / roguelite" (locationEyebrow). */
  eyebrow: string;
  /** Figure number for the cover's default caption. */
  index: number;
}
const { project, eyebrow, index } = Astro.props;
const d = project.data;
const href = `/projects/${project.id}/`;
const cover = d.media[0];
const view = projectView(d);
---

<article class="loc-row tag" id={project.id} style={`--acc: ${d.world.accent}; --reveal-delay:${index}`} data-reveal>
  <div class="body">
    <p class="eyebrow"><i class="diamond" data-visit-dot={project.id} aria-hidden="true"></i>{eyebrow}</p>
    <h2 class="tag-title"><a href={href} transition:name={`title-${project.id}`}>{d.title}</a></h2>
    <p class="meta-row">
      <span class:list={['pill', view.live ? 'play' : 'wip']}>{view.status}</span><span>{view.period}</span><span>{d.engine}</span>
    </p>
    <p class="summary">{d.summary}</p>
    {
      d.highlights.length > 0 && (
        <ul class="diamond-list">
          {d.highlights.map((h) => (
            <li>{h}</li>
          ))}
        </ul>
      )
    }
    <div class="keys">
      {view.live && <a class="btn primary" href={view.live.href}>{view.live.label}</a>}
      <a class="btn" href={href}>Read the write-up →</a>
      <a class="btn" href={`/#${project.id}`}>On the map</a>
      {d.githubUrl && <a class="btn" href={d.githubUrl}>Source ↗</a>}
    </div>
  </div>
  <!-- transition:name pairs this cover with the write-up's hero figure: it morphs across the page change. -->
  <a class="cover" href={href} aria-label={`${d.title} write-up`} tabindex="-1" transition:name={`cover-${project.id}`}>
    <Figure
      type={cover?.type}
      src={cover?.src}
      alt={cover?.alt ?? `${d.title} screenshot`}
      caption={cover?.caption ?? `Fig. ${index + 1} — ${d.title}`}
      ratio="4 / 3"
    />
  </a>
</article>

<style>
  .loc-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 310px;
    gap: 28px;
    align-items: start;
    margin-bottom: 32px;
    padding: 24px 28px 28px;
    scroll-margin-top: 96px;
  }
  .loc-row .eyebrow {
    font-size: 11.5px;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 6px;
  }
  .tag-title {
    font-size: clamp(28px, 3.4vw, 38px);
    line-height: 1.1;
    margin: 0 0 10px;
  }
  .tag-title a {
    color: var(--text);
  }
  .tag-title a:hover {
    color: color-mix(in srgb, var(--acc-ui) var(--acc-ink), var(--text));
  }
  .meta-row .pill {
    margin: 0;
  }
  .summary {
    margin: 12px 0;
    max-width: 60ch;
    color: var(--text-2);
  }
  .diamond-list {
    margin: 0 0 16px;
  }
  .keys {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .cover {
    display: block;
  }
  .cover:hover :global(.frame) {
    transform: translateY(-3px);
  }
  @media (max-width: 980px) {
    .loc-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
      padding: 20px;
    }
    .cover {
      order: -1;
    }
  }
</style>

---
/**
 * Telegraph Recall — A 3-Stage CRT Experience + Non-Linear Exploratory Portal Layout
 * + 4x4 Tactical Working-Memory Micro-Game connecting Push Comes to Shove,
 * Cinderhold, and the phanto YouTube channel.
 */
import NonLinearLayout from './NonLinearLayout.astro';
import PopupCRT from './PopupCRT.astro';
---

<section id="lab" class="section" data-crt-interactive-root>
  <noscript>
    <style>
      #lab .crt-launchpad, #lab .nonlinear-section, #lab .cabinet { display: none; }
    </style>
  </noscript>
  <div class="wrap">
    <div class="section-head-bar" data-reveal>
      <div>
        <h2>Telegraph Recall</h2>
        <p class="sub-h">Watch the signal, then repeat the sequence.</p>
      </div>
      <span class="section-index-tag" aria-hidden="true">03</span>
    </div>
    <noscript><p>Telegraph Recall needs JavaScript. You can still explore the <a href="#projects">playable projects</a>.</p></noscript>

    <!-- Top Terminal Control Strip: Launch CRT Popup + Live Per-Click Telemetry -->
    <div class="crt-launchpad crt-frame" data-reveal style="--reveal-delay:1">
      <div class="crt-launchpad-info">
        <span class="crt-led" aria-hidden="true"></span>
        <span class="meta"><b>CRT_EXPERIENCE // 3 STAGES</b> · WELCOME → ANIMATION SEQUENCE → TELEGRAPH RECALL</span>
      </div>
      <div class="crt-launchpad-actions">
        <span id="tg-interaction-log" class="meta crt-telemetry-pill" aria-hidden="true">
          PULSES: <b id="tg-interaction-count">0</b> · STAGE: <b id="tg-current-stage-badge">STG_01</b>
        </span>
        <button
          type="button"
          id="tg-open-popup"
          class="btn primary"
          aria-haspopup="dialog"
          aria-controls="tg-crt-popup"
          data-track="crt-popup-open"
        >
          Play Telegraph Recall
        </button>
      </div>
    </div>

    <NonLinearLayout />

    <div class="two">
      <div data-reveal style="--reveal-delay:1">
        <p class="kicker" style="margin-bottom:10px">Field Note Lab · Game Psychology &amp; Deterministic Systems</p>
        <p>
          In <a href="/projects/push-comes-to-shove/">Push Comes to Shove</a> and
          <a href="/projects/cinderhold/">Cinderhold</a>, combat is built around readable telegraphs rather than hidden
          rolls. This small game explores the challenge of remembering a sequence of visual cues.
        </p>
        <p class="muted">
          Watch the enemy windup sequence on the 4×4 board (from 3 tiles in Wave 1 up to 7 tiles in Wave 5), then step
          through the telegraphed cells in order. Play with mouse, touch, or keyboard (<code>WASD</code> / Arrow keys +
          <code>Enter</code> or <code>Space</code>). Need a second look? Spend your single <b>Forecast Hint</b> to replay
          the board simulation. Turn on <b>Manual cues</b> to advance the sequence at your own pace.
        </p>
        <div class="stat-chips" aria-label="Mini-game technical architecture">
          <span class="stat-chip">Pure TS state machine</span>
          <span class="stat-chip">3-Stage CRT Popup &amp; Router</span>
          <span class="stat-chip">Procedural Web Audio synth</span>
          <span class="stat-chip">Zero external audio/image assets</span>
        </div>
      </div>

      <div class="cabinet crt-frame" role="region" aria-labelledby="tg-heading" data-reveal data-tilt data-tilt-max="3.5" style="--reveal-delay:2" data-crt-ripple>
        <div class="cab-bar">
          <span id="tg-heading" class="meta"><b>TACTICAL_CRT v2.0</b> · 4×4 GRID</span>
          <span class="meta">WAVE <b id="tg-wave">1</b>/5 · STREAK <b id="tg-score">0</b></span>
        </div>

        <div id="tg-grid" class="tg-grid" role="group" aria-label="4 by 4 tactical telegraph board">
          {
            Array.from({ length: 16 }).map((_, idx) => {
              const r = Math.floor(idx / 4) + 1;
              const c = (idx % 4) + 1;
              return (
                <button
                  type="button"
                  class="tg-cell"
                  data-idx={idx}
                  data-crt-ripple
                  aria-label={`Row ${r}, Column ${c}`}
                >
                  <span class="coord" aria-hidden="true">
                    {r},{c}
                  </span>
                  <span class="step-badge" aria-hidden="true" />
                </button>
              );
            })
          }
        </div>

        <p id="tg-status" class="tg-status" aria-live="polite">
          Press "Start Turn" to observe the Wave 1 telegraph sequence (3 tiles).
        </p>

        <div class="cab-actions">
          <button type="button" id="tg-start" class="btn primary" data-track="minigame-start" data-track-meta="wave-1" data-crt-ripple>
            ▶ Start Turn
          </button>
          <button type="button" id="tg-hint" class="btn" disabled data-track="minigame-hint" data-track-meta="forecast" data-crt-ripple>
            Forecast Hint (1)
          </button>
          <button type="button" id="tg-manual" class="btn" aria-label="Manual cue playback" aria-pressed="false" data-crt-ripple>
            Manual cues: off
          </button>
          <button type="button" id="tg-next-cue" class="btn" hidden>
            Show first cue
          </button>
          <button type="button" id="tg-mute" class="btn" aria-label="Sound effects" aria-pressed="false" data-crt-ripple>
            Sound: off
          </button>
        </div>
      </div>
    </div>
  </div>

  <PopupCRT />
</section>

<script>
  // The Telegraph Recall script is the largest on the page and nothing above the fold needs it:
  // load it when the section comes within 600px of the viewport (or at once without IntersectionObserver,
  // or when the URL deep-links into the lab). Re-armed on every arrival at the home page: the module is
  // cached after the first import and its init() binds the fresh DOM.
  let loading: Promise<{ init: () => void }> | null = null;
  const load = () => (loading ??= import('../scripts/telegraph-ui')).then((m) => m.init());
  const arm = () => {
    const lab = document.getElementById('lab');
    if (!lab || lab.dataset.tgReady) return;
    if (/^#lab(\?|$)/.test(location.hash) || !('IntersectionObserver' in window)) {
      void load();
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          io.disconnect();
          void load();
        }
      },
      { rootMargin: '600px 0px' },
    );
    io.observe(lab);
    lab.addEventListener('pointerenter', () => void load(), { once: true });
    lab.addEventListener('focusin', () => void load(), { once: true });
  };
  document.addEventListener('astro:page-load', arm);
</script>

<style>
  /* Launchpad Strip */
  .crt-launchpad {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    background: var(--surface);
    border: 1px solid var(--umber);
    border-radius: var(--r-md);
    padding: 14px 20px;
    margin-bottom: 24px;
  }
  .crt-launchpad-info {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .crt-launchpad-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .crt-telemetry-pill {
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--bg);
    border: 1px solid var(--umber);
  }
  .crt-led {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--coral);
    box-shadow: 0 0 10px var(--coral);
    display: inline-block;
  }

  /* The click ripple (.crt-click-ripple) is site-wide now: global.css. */

  /* 4x4 Tactical Board Cabinet */
  .cabinet {
    background: var(--surface);
    border: 1px solid var(--umber);
    border-radius: var(--r-md);
    padding: 20px;
  }
  .cab-bar {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
    border-bottom: var(--line);
    padding-bottom: 10px;
    margin-bottom: 16px;
  }
  .tg-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-bottom: 16px;
  }
  .tg-cell {
    aspect-ratio: 1;
    color: var(--text-3);
    font-family: var(--mono);
    font-size: 11px;
    position: relative;
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: transform 0.15s, border-color 0.15s, background 0.15s;
  }
  .tg-cell:hover {
    border-color: var(--peach);
  }
  .tg-cell.telegraph {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.18), rgba(0, 0, 0, 0.1)), var(--cell-telegraph);
    border-color: var(--coral);
    box-shadow: var(--glow);
    color: var(--text);
  }
  .tg-cell.hit {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.18), rgba(0, 0, 0, 0.1)), var(--cell-hit);
    border-color: var(--mint);
    color: var(--mint);
  }
  .tg-cell.miss {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.18), rgba(0, 0, 0, 0.1)), var(--cell-miss);
    border-color: var(--coral);
  }
  .tg-cell.unavailable {
    box-shadow: inset 0 0 0 3px var(--coral);
  }
  .coord {
    position: absolute;
    top: 4px;
    left: 6px;
    font-size: 9px;
    opacity: 0.7;
  }
  .step-badge {
    font-family: var(--display);
    font-size: 20px;
    font-weight: 600;
    color: var(--text);
  }
  .tg-status {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--gold);
    min-height: 2.8em;
    margin-bottom: 12px;
  }
  .cab-actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
</style>

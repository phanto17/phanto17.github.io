---
/**
 * Telegraph Recall — A 3-Stage CRT Experience + Non-Linear Exploratory Portal Layout
 * + 4x4 Tactical Working-Memory Micro-Game connecting Push Comes to Shove,
 * Cinderhold, and the phanto YouTube channel.
 */
import { TELEGRAPH_PORTAL_NODES, TELEGRAPH_STAGES } from '../scripts/telegraph-engine';
---

<section id="lab" class="section" data-crt-interactive-root>
  <div class="wrap">
    <div class="section-head-bar" data-reveal>
      <div>
        <h2>Telegraph Recall</h2>
        <p class="sub-h">3-stage CRT experience · non-linear portal grid · 4×4 spatial working memory</p>
      </div>
      <span class="section-index-tag" aria-hidden="true">03</span>
    </div>

    <!-- Top Terminal Control Strip: Launch CRT Popup + Live Per-Click Telemetry -->
    <div class="crt-launchpad crt-frame" data-reveal style="--reveal-delay:1">
      <div class="crt-launchpad-info">
        <span class="crt-led" aria-hidden="true"></span>
        <span class="meta"><b>CRT_EXPERIENCE // 3 STAGES</b> · WELCOME → ANIMATION SEQUENCE → TELEGRAPH RECALL</span>
      </div>
      <div class="crt-launchpad-actions">
        <span id="tg-interaction-log" class="meta crt-telemetry-pill" aria-live="polite">
          PULSES: <b id="tg-interaction-count">0</b> · STAGE: <b id="tg-current-stage-badge">STG_01</b>
        </span>
        <button
          type="button"
          id="tg-open-popup"
          class="btn primary"
          aria-haspopup="dialog"
          aria-controls="tg-crt-popup"
          data-track="crt-popup-open"
        >
          ▣ Launch 3-Stage CRT Briefing
        </button>
      </div>
    </div>

    <!-- Non-Linear Exploratory Portal Grid (NonLinearLayout + InteractivePanel) -->
    <div class="nonlinear-section" data-reveal style="--reveal-delay:1">
      <div class="nonlinear-header">
        <p class="kicker">Non-Linear Exploratory Portal · Discover in Any Order</p>
        <span class="meta">EXPLORED: <b id="tg-portal-progress">1</b>/{TELEGRAPH_PORTAL_NODES.length} NODES</span>
      </div>

      <div
        id="tg-portal-grid"
        class="nonlinear-grid"
        role="tablist"
        aria-label="Telegraph Recall non-linear field note portals"
      >
        {
          TELEGRAPH_PORTAL_NODES.map((node, i) => (
            <button
              type="button"
              role="tab"
              id={`portal-tab-${node.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls="tg-portal-inspector"
              class={`interactive-panel crt-frame ${i === 0 ? 'is-active is-explored' : ''}`}
              data-portal-id={node.id}
              data-crt-ripple
            >
              <div class="panel-top">
                <span class="panel-code">{node.code}</span>
                <span class="panel-status" aria-hidden="true">{i === 0 ? '● ACTIVE' : '○ PORTAL'}</span>
              </div>
              <h3 class="panel-title">{node.title}</h3>
              <p class="panel-summary">{node.summary}</p>
              <span class="panel-tag">{node.tag}</span>
            </button>
          ))
        }
      </div>

      <!-- Dynamic Portal Inspector Scene -->
      <div
        id="tg-portal-inspector"
        class="portal-inspector crt-frame"
        role="tabpanel"
        aria-labelledby="portal-tab-psychology"
        aria-live="polite"
        data-crt-ripple
      >
        <div class="inspector-bar">
          <span id="inspector-code" class="meta"><b>{TELEGRAPH_PORTAL_NODES[0].code}</b> · {TELEGRAPH_PORTAL_NODES[0].tag}</span>
          <span class="meta">CLICK ANY PANEL FOR PHOSPHOR RIPPLE + SYNTH RESPONSE</span>
        </div>
        <h4 id="inspector-title" class="inspector-title">{TELEGRAPH_PORTAL_NODES[0].title}</h4>
        <p id="inspector-detail" class="inspector-detail">{TELEGRAPH_PORTAL_NODES[0].detail}</p>
        <div class="inspector-footer">
          <a
            id="inspector-link"
             class="btn"
            href={TELEGRAPH_PORTAL_NODES[0].projectHref ?? '#tg-grid'}
          >
            {TELEGRAPH_PORTAL_NODES[0].projectLabel ?? 'Jump to 4×4 Tactical Board ↓'}
          </a>
          <button type="button" id="inspector-open-stage3" class="btn">
            Open in CRT Stage 03 Modal ↗
          </button>
        </div>
      </div>
    </div>

    <div class="two">
      <div data-reveal style="--reveal-delay:1">
        <p class="kicker" style="margin-bottom:10px">Field Note Lab · Game Psychology &amp; Deterministic Systems</p>
        <p>
          In <a href="/projects/push-comes-to-shove/">Push Comes to Shove</a> and
          <a href="/projects/cinderhold/">Cinderhold</a>, combat is built around readable telegraphs rather than hidden
          rolls. Human spatial working memory holds roughly 4 to 7 chunks at once (Miller's Law) — the exact sweet spot
          where a tactical turn feels tense but solvable.
        </p>
        <p class="muted">
          Watch the enemy windup sequence on the 4×4 board (from 3 tiles in Wave 1 up to 7 tiles in Wave 5), then step
          through the telegraphed cells in order. Play with mouse, touch, or keyboard (<code>WASD</code> / Arrow keys +
          <code>Enter</code> or <code>Space</code>). Need a second look? Spend your single <b>Forecast Hint</b> to replay
          the board simulation.
        </p>
        <div class="stat-chips" aria-label="Mini-game technical architecture">
          <span class="stat-chip">Pure TS state machine</span>
          <span class="stat-chip">3-Stage CRT Popup &amp; Router</span>
          <span class="stat-chip">Procedural Web Audio synth</span>
          <span class="stat-chip">Zero external audio/image assets</span>
        </div>
      </div>

      <div class="cabinet crt-frame" role="region" aria-labelledby="tg-heading" data-reveal data-tilt data-tilt-max="3.5" style="--reveal-delay:2" data-crt-ripple>
        <div class="cab-bar">
          <span id="tg-heading" class="meta"><b>TACTICAL_CRT v2.0</b> · 4×4 GRID</span>
          <span class="meta">WAVE <b id="tg-wave">1</b>/5 · STREAK <b id="tg-score">0</b></span>
        </div>

        <div id="tg-grid" class="tg-grid" role="grid" aria-label="4 by 4 tactical telegraph board">
          {
            Array.from({ length: 16 }).map((_, idx) => {
              const r = Math.floor(idx / 4) + 1;
              const c = (idx % 4) + 1;
              return (
                <button
                  type="button"
                  class="tg-cell"
                  data-idx={idx}
                  data-crt-ripple
                  role="gridcell"
                  aria-label={`Row ${r}, Column ${c}`}
                >
                  <span class="coord" aria-hidden="true">
                    {r},{c}
                  </span>
                  <span class="step-badge" aria-hidden="true" />
                </button>
              );
            })
          }
        </div>

        <p id="tg-status" class="tg-status" aria-live="polite">
          Press "Start Turn" to observe the Wave 1 telegraph sequence (3 tiles).
        </p>

        <div class="cab-actions">
          <button type="button" id="tg-start" class="btn primary" data-track="minigame-start" data-track-meta="wave-1" data-crt-ripple>
            ▶ Start Turn
          </button>
          <button type="button" id="tg-hint" class="btn" disabled data-track="minigame-hint" data-track-meta="forecast" data-crt-ripple>
            Forecast Hint (1)
          </button>
          <button type="button" id="tg-mute" class="btn" aria-pressed="false" data-crt-ripple>
            SFX: ON
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- PopupCRT Modal: 3-Stage Guided Experience (Welcome -> Animation Sequence -> Telegraph Recall) -->
  <div
    id="tg-crt-popup"
    class="crt-popup-backdrop"
    role="dialog"
    aria-modal="true"
    aria-labelledby="crt-stage-title"
    aria-describedby="crt-stage-subtitle"
    hidden
  >
    <div class="crt-popup-monitor crt-frame" data-crt-ripple>
      <div class="crt-popup-scanlines" aria-hidden="true"></div>
      <div class="crt-popup-vignette" aria-hidden="true"></div>

      <!-- Monitor Top Bezel Bar -->
      <div class="crt-popup-topbar">
        <div class="crt-popup-brand">
          <span class="crt-led" aria-hidden="true"></span>
          <span id="crt-stage-code" class="meta">STG_01 // SYS_HANDSHAKE</span>
        </div>
        <div class="crt-stage-tabs" role="tablist" aria-label="CRT Experience Stages">
          {
            TELEGRAPH_STAGES.map((stg, idx) => (
              <button
                type="button"
                role="tab"
                class={`crt-stage-tab ${idx === 0 ? 'is-active' : ''}`}
                data-stage-target={stg.id}
                aria-selected={idx === 0 ? 'true' : 'false'}
                data-crt-ripple
              >
                0{stg.index} · {stg.id === 'welcome' ? 'Welcome' : stg.id === 'animation-sequence' ? 'Sequence' : 'Recall'}
              </button>
            ))
          }
        </div>
        <button type="button" id="tg-close-popup" class="crt-close-btn" aria-label="Close CRT terminal (Escape)" data-crt-ripple>
          [ESC ×]
        </button>
      </div>

      <!-- StageRouter Viewport -->
      <div id="tg-stage-router" class="crt-stage-viewport" data-transition="crt-flicker">
        <!-- STAGE 1: WELCOME SCREEN -->
        <article class="crt-scene is-current" data-stage-scene="welcome">
          <p class="kicker">STAGE 01 OF 03 · TERMINAL INITIALIZATION</p>
          <h3 id="crt-stage-title" class="crt-scene-title">Welcome to Field Note Terminal 03</h3>
          <p id="crt-stage-subtitle" class="crt-scene-sub">
            Interactive CRT Telemetry · Spatial Working Memory &amp; Deterministic Combat Design
          </p>
          <div class="crt-welcome-grid">
            <div class="crt-diag-card" data-crt-ripple>
              <span class="meta">01 // OPERATOR</span>
              <strong>Tymoteusz Jaskólski</strong>
              <span>Junior Gameplay Programmer (Unity / C#)</span>
            </div>
            <div class="crt-diag-card" data-crt-ripple>
              <span class="meta">02 // COGNITIVE TARGET</span>
              <strong>Miller's Law (4–7 Chunks)</strong>
              <span>Spatial windup recall under turn pressure</span>
            </div>
            <div class="crt-diag-card" data-crt-ripple>
              <span class="meta">03 // AUDIO &amp; MOTION</span>
              <strong>Procedural Web Audio</strong>
              <span>Every click triggers phosphor ripple + synth tone</span>
            </div>
          </div>
          <p class="crt-terminal-prompt">
            &gt; SYSTEM READY. Click anywhere inside the monitor to test phosphor pulse feedback, or advance to Stage 02.
          </p>
        </article>

        <!-- STAGE 2: ANIMATION SEQUENCE -->
        <article class="crt-scene" data-stage-scene="animation-sequence" hidden>
          <p class="kicker">STAGE 02 OF 03 · SIGNAL SWEEP &amp; TELEGRAPH CALIBRATION</p>
          <h3 class="crt-scene-title">Enemy Windup &amp; Spatial Chunking Sequence</h3>
          <p class="crt-scene-sub">
            Simulating deterministic threat vectors across a 4×4 tactical grid before player input unlocks.
          </p>

          <div class="crt-anim-stage" id="crt-anim-canvas" data-crt-ripple>
            <div class="crt-radar-sweep" aria-hidden="true"></div>
            <div class="crt-mini-matrix" aria-label="Animated telegraph calibration preview">
              {
                Array.from({ length: 16 }).map((_, i) => (
                  <div class="crt-mini-cell" data-preview-cell={i}>
                    <span>{Math.floor(i / 4) + 1},{(i % 4) + 1}</span>
                  </div>
                ))
              }
            </div>
            <div class="crt-anim-readout">
              <p class="meta">SIGNAL_TRACE // <b id="crt-seq-step-label">SCANNING VECTORS...</b></p>
              <div class="crt-wave-bars" aria-hidden="true">
                <span></span><span></span><span></span><span></span><span></span><span></span><span></span>
              </div>
              <p class="muted" style="font-size:13px;margin:0">
                Click any cell or bar to inject a manual calibration pulse into the waveform.
              </p>
            </div>
          </div>
        </article>

        <!-- STAGE 3: TELEGRAPH RECALL TITLE / INTRO + PORTAL LAUNCH -->
        <article class="crt-scene" data-stage-scene="title-intro" hidden>
          <p class="kicker">STAGE 03 OF 03 · SYSTEM ONLINE</p>
          <div class="crt-title-hero">
            <h3 class="crt-logo-title">TELEGRAPH RECALL</h3>
            <p class="crt-scene-sub">
              Read the windup. Chunk the coordinates. Execute the perfect turn.
            </p>
          </div>
          <p class="crt-intro-copy">
            Inspired by the deterministic 1-tile melee shove puzzles in <b>Push Comes to Shove</b> and the pure-C#
            <code>AttackTelegraph</code> windows in <b>Cinderhold</b>, <em>Telegraph Recall</em> isolates the core cognitive
            loop of tactical games: holding an enemy's multi-step intent in spatial working memory long enough to counter it.
          </p>
          <div class="crt-stage3-portals">
            {
              TELEGRAPH_PORTAL_NODES.map((node) => (
                <button
                  type="button"
                  class="crt-stage3-node"
                  data-popup-portal={node.id}
                  data-crt-ripple
                >
                  <span class="meta">{node.code}</span>
                  <strong>{node.title}</strong>
                  <span>{node.tag}</span>
                </button>
              ))
            }
          </div>
        </article>
      </div>

      <!-- Monitor Bottom Control Bar -->
      <div class="crt-popup-footer">
        <div class="meta">
          KEYS: <code>1</code> <code>2</code> <code>3</code> STAGES · <code>TAB</code> FOCUS · <code>ESC</code> EXIT
        </div>
        <div class="crt-popup-cta-group">
          <button type="button" id="crt-prev-stage" class="btn" data-crt-ripple>
            ← Prev Stage
          </button>
          <button type="button" id="crt-next-stage" class="btn primary" data-crt-ripple>
            Initialize Sequence [Stage 02] →
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import {
    TelegraphEngine,
    TelegraphStageController,
    type PortalNodeId,
    type StageId,
  } from '../scripts/telegraph-engine';

  const engine = new TelegraphEngine();
  const stageCtrl = new TelegraphStageController();

  const cells = Array.from(document.querySelectorAll<HTMLButtonElement>('#tg-grid .tg-cell'));
  const statusEl = document.querySelector<HTMLElement>('#tg-status');
  const waveEl = document.querySelector<HTMLElement>('#tg-wave');
  const scoreEl = document.querySelector<HTMLElement>('#tg-score');
  const startBtn = document.querySelector<HTMLButtonElement>('#tg-start');
  const hintBtn = document.querySelector<HTMLButtonElement>('#tg-hint');
  const muteBtn = document.querySelector<HTMLButtonElement>('#tg-mute');

  // CRT Popup & StageRouter elements
  const popupBackdrop = document.querySelector<HTMLElement>('#tg-crt-popup');
  const openPopupBtn = document.querySelector<HTMLButtonElement>('#tg-open-popup');
  const closePopupBtn = document.querySelector<HTMLButtonElement>('#tg-close-popup');
  const prevStageBtn = document.querySelector<HTMLButtonElement>('#crt-prev-stage');
  const nextStageBtn = document.querySelector<HTMLButtonElement>('#crt-next-stage');
  const stageRouter = document.querySelector<HTMLElement>('#tg-stage-router');
  const stageCodeEl = document.querySelector<HTMLElement>('#crt-stage-code');
  const stageTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.crt-stage-tab'));
  const stageScenes = Array.from(document.querySelectorAll<HTMLElement>('[data-stage-scene]'));
  const previewCells = Array.from(document.querySelectorAll<HTMLElement>('[data-preview-cell]'));
  const seqStepLabel = document.querySelector<HTMLElement>('#crt-seq-step-label');

  // Non-linear portal elements
  const portalBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-portal-id]'));
  const popupPortalBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-popup-portal]'));
  const portalProgressEl = document.querySelector<HTMLElement>('#tg-portal-progress');
  const inspectorEl = document.querySelector<HTMLElement>('#tg-portal-inspector');
  const inspectorCode = document.querySelector<HTMLElement>('#inspector-code');
  const inspectorTitle = document.querySelector<HTMLElement>('#inspector-title');
  const inspectorDetail = document.querySelector<HTMLElement>('#inspector-detail');
  const inspectorLink = document.querySelector<HTMLAnchorElement>('#inspector-link');
  const inspectorOpenStage3Btn = document.querySelector<HTMLButtonElement>('#inspector-open-stage3');

  // Telemetry counters
  const interactionCountEl = document.querySelector<HTMLElement>('#tg-interaction-count');
  const currentStageBadgeEl = document.querySelector<HTMLElement>('#tg-current-stage-badge');

  let muted = false;
  let audioCtx: AudioContext | null = null;
  let playbackToken = 0;
  let stage2Timer: number | null = null;
  let lastFocusedBeforeModal: HTMLElement | null = null;

  const isReducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function playTone(freq: number, type: OscillatorType = 'triangle', duration = 0.11) {
    if (muted) return;
    try {
      audioCtx = audioCtx ?? new AudioContext();
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = type;
      osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
      gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
      osc.connect(gain).connect(audioCtx.destination);
      osc.start();
      osc.stop(audioCtx.currentTime + duration);
    } catch {
      /* AudioContext unavailable or blocked */
    }
  }

  function syncTelemetryHud() {
    if (interactionCountEl) {
      interactionCountEl.textContent = String(stageCtrl.getInteractionCount());
    }
    if (currentStageBadgeEl) {
      const cfg = stageCtrl.getStageConfig();
      currentStageBadgeEl.textContent = `STG_0${cfg.index}`;
    }
    if (portalProgressEl) {
      portalProgressEl.textContent = String(stageCtrl.getExploredPortals().length);
    }
  }

  // Per-click visual phosphor ripple + subtle synth click across any [data-crt-ripple] surface
  function spawnPhosphorRipple(e: MouseEvent) {
    const target = (e.target as HTMLElement | null)?.closest<HTMLElement>('[data-crt-ripple]');
    if (!target) return;

    const rect = target.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;

    stageCtrl.recordInteraction('click-ripple', target.id || target.className, { x: Math.round(x), y: Math.round(y) });
    syncTelemetryHud();

    if (!isReducedMotion()) {
      const ripple = document.createElement('span');
      ripple.className = 'crt-click-ripple';
      ripple.style.left = `${x}px`;
      ripple.style.top = `${y}px`;
      target.appendChild(ripple);
      ripple.addEventListener('animationend', () => ripple.remove(), { once: true });
      setTimeout(() => ripple.remove(), 650);
    }
  }

  document.querySelector('[data-crt-interactive-root]')?.addEventListener('click', (e) => {
    spawnPhosphorRipple(e as MouseEvent);
  });

  // Stage 2 automated preview animation loop
  function startStage2PreviewLoop() {
    stopStage2PreviewLoop();
    const demoPath = [2, 5, 10, 13, 7, 8, 15];
    let step = 0;
    const tick = () => {
      previewCells.forEach((c) => c.classList.remove('is-lit'));
      const cellIdx = demoPath[step % demoPath.length];
      previewCells[cellIdx]?.classList.add('is-lit');
      const coord = TelegraphEngine.cellToCoord(cellIdx);
      if (seqStepLabel) {
        seqStepLabel.textContent = `CHUNK 0${(step % demoPath.length) + 1}/07 → ROW ${coord.row}, COL ${coord.col}`;
      }
      playTone(260 + (step % 7) * 45, 'sine', 0.07);
      step += 1;
    };
    tick();
    stage2Timer = window.setInterval(tick, isReducedMotion() ? 900 : 520);
  }

  function stopStage2PreviewLoop() {
    if (stage2Timer !== null) {
      window.clearInterval(stage2Timer);
      stage2Timer = null;
    }
    previewCells.forEach((c) => c.classList.remove('is-lit'));
  }

  // StageRouter transition renderer
  function renderStage(targetStage: StageId) {
    const { to } = stageCtrl.transitionTo(targetStage);
    syncTelemetryHud();

    if (stageCodeEl) stageCodeEl.textContent = to.code;
    if (stageRouter) {
      stageRouter.setAttribute('data-transition', isReducedMotion() ? 'instant' : to.transition);
      stageRouter.classList.remove('is-transitioning');
      void stageRouter.offsetWidth;
      if (!isReducedMotion()) {
        stageRouter.classList.add('is-transitioning');
      }
    }

    stageScenes.forEach((scene) => {
      const isMatch = scene.getAttribute('data-stage-scene') === targetStage;
      scene.hidden = !isMatch;
      scene.classList.toggle('is-current', isMatch);
    });

    stageTabs.forEach((tab) => {
      const isMatch = tab.getAttribute('data-stage-target') === targetStage;
      tab.classList.toggle('is-active', isMatch);
      tab.setAttribute('aria-selected', String(isMatch));
    });

    if (nextStageBtn) {
      nextStageBtn.textContent = to.ctaLabel;
    }

    if (targetStage === 'animation-sequence') {
      startStage2PreviewLoop();
    } else {
      stopStage2PreviewLoop();
    }

    playTone(targetStage === 'welcome' ? 330 : targetStage === 'animation-sequence' ? 440 : 587, 'triangle', 0.14);
  }

  function openCrtPopup(initialStage: StageId = 'welcome') {
    if (!popupBackdrop) return;
    lastFocusedBeforeModal = document.activeElement as HTMLElement | null;
    stageCtrl.setPopupOpen(true);
    popupBackdrop.hidden = false;
    document.body.style.overflow = 'hidden';
    renderStage(initialStage);
    closePopupBtn?.focus();
  }

  function closeCrtPopup() {
    if (!popupBackdrop || popupBackdrop.hidden) return;
    stopStage2PreviewLoop();
    stageCtrl.setPopupOpen(false);
    popupBackdrop.hidden = true;
    document.body.style.overflow = '';
    syncTelemetryHud();
    playTone(220, 'sine', 0.1);
    lastFocusedBeforeModal?.focus();
  }

  openPopupBtn?.addEventListener('click', () => openCrtPopup('welcome'));
  closePopupBtn?.addEventListener('click', () => closeCrtPopup());
  inspectorOpenStage3Btn?.addEventListener('click', () => openCrtPopup('title-intro'));

  popupBackdrop?.addEventListener('click', (e) => {
    if (e.target === popupBackdrop) closeCrtPopup();
  });

  prevStageBtn?.addEventListener('click', () => {
    const order: StageId[] = ['welcome', 'animation-sequence', 'title-intro'];
    const idx = order.indexOf(stageCtrl.getStage());
    const prev = order[(idx + order.length - 1) % order.length];
    renderStage(prev);
  });

  nextStageBtn?.addEventListener('click', () => {
    if (stageCtrl.getStage() === 'title-intro') {
      closeCrtPopup();
      document.querySelector<HTMLElement>('#tg-start')?.focus();
      const seq = engine.startCampaign();
      void playTelegraphSequence(seq);
      return;
    }
    const { to } = stageCtrl.nextStage();
    renderStage(to.id);
  });

  stageTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.getAttribute('data-stage-target') as StageId | null;
      if (target) renderStage(target);
    });
  });

  // Focus trap + keyboard shortcuts inside PopupCRT
  document.addEventListener('keydown', (e) => {
    if (!popupBackdrop || popupBackdrop.hidden) return;

    if (e.key === 'Escape') {
      e.preventDefault();
      closeCrtPopup();
      return;
    }
    if (e.key === '1') {
      renderStage('welcome');
      return;
    }
    if (e.key === '2') {
      renderStage('animation-sequence');
      return;
    }
    if (e.key === '3') {
      renderStage('title-intro');
      return;
    }
    if (e.key === 'Tab') {
      const focusable = Array.from(
        popupBackdrop.querySelectorAll<HTMLElement>(
          'button:not([disabled]), [href], [tabindex]:not([tabindex="-1"])',
        ),
      ).filter((el) => !el.closest('[hidden]'));
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });

  // Non-linear Portal selection logic
  function activatePortalNode(portalId: PortalNodeId) {
    const { node } = stageCtrl.selectPortal(portalId);
    syncTelemetryHud();
    playTone(392, 'triangle', 0.1);

    portalBtns.forEach((btn) => {
      const id = btn.getAttribute('data-portal-id') as PortalNodeId;
      const isSelected = id === portalId;
      btn.classList.toggle('is-active', isSelected);
      if (isSelected) btn.classList.add('is-explored');
      btn.setAttribute('aria-selected', String(isSelected));
      const statusBadge = btn.querySelector<HTMLElement>('.panel-status');
      if (statusBadge) {
        statusBadge.textContent = isSelected
          ? '● ACTIVE'
          : stageCtrl.getExploredPortals().includes(id)
            ? '✓ EXPLORED'
            : '○ PORTAL';
      }
    });

    if (inspectorEl) {
      inspectorEl.setAttribute('aria-labelledby', `portal-tab-${portalId}`);
    }
    if (inspectorCode) inspectorCode.innerHTML = `<b>${node.code}</b> · ${node.tag}`;
    if (inspectorTitle) inspectorTitle.textContent = node.title;
    if (inspectorDetail) inspectorDetail.textContent = node.detail;
    if (inspectorLink) {
      inspectorLink.href = node.projectHref ?? '#tg-grid';
      inspectorLink.textContent = node.projectLabel ?? 'Jump to 4×4 Tactical Board ↓';
    }
  }

  portalBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-portal-id') as PortalNodeId | null;
      if (id) activatePortalNode(id);
    });
  });

  popupPortalBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-popup-portal') as PortalNodeId | null;
      if (id) {
        activatePortalNode(id);
        closeCrtPopup();
        inspectorEl?.scrollIntoView({ behavior: isReducedMotion() ? 'auto' : 'smooth', block: 'center' });
      }
    });
  });

  function clearBoardVisuals() {
    cells.forEach((cell) => {
      cell.classList.remove('telegraph', 'hit', 'miss');
      const badge = cell.querySelector<HTMLElement>('.step-badge');
      if (badge) badge.textContent = '';
    });
  }

  function syncHud() {
    if (waveEl) waveEl.textContent = String(engine.getWave());
    if (scoreEl) scoreEl.textContent = String(engine.getStreak());
    if (hintBtn) {
      hintBtn.textContent = `Forecast Hint (${engine.getHintsRemaining()})`;
      hintBtn.disabled = !engine.isAcceptingInput() || engine.getHintsRemaining() <= 0;
    }
  }

  async function playTelegraphSequence(seq: readonly number[]) {
    const myToken = ++playbackToken;
    engine.setAcceptingInput(false);
    clearBoardVisuals();
    syncHud();

    const stepMs = isReducedMotion() ? 640 : 500;
    for (let i = 0; i < seq.length; i++) {
      if (myToken !== playbackToken) return;
      const idx = seq[i];
      const cell = cells[idx];
      const badge = cell?.querySelector<HTMLElement>('.step-badge');
      cell?.classList.add('telegraph');
      if (badge) badge.textContent = String(i + 1);
      playTone(300 + i * 55, 'triangle', 0.12);

      if (statusEl) {
        const { row, col } = TelegraphEngine.cellToCoord(idx);
        statusEl.textContent = `Wave ${engine.getWave()} Telegraph ${i + 1} of ${seq.length}: Row ${row}, Col ${col}`;
      }

      await new Promise((r) => setTimeout(r, stepMs));
      if (myToken !== playbackToken) return;

      if (!isReducedMotion()) {
        cell?.classList.remove('telegraph');
        if (badge) badge.textContent = '';
      }
      await new Promise((r) => setTimeout(r, 110));
    }

    if (myToken !== playbackToken) return;
    clearBoardVisuals();
    engine.setAcceptingInput(true);
    syncHud();
    if (statusEl) {
      statusEl.textContent = `Your turn: reproduce all ${seq.length} telegraphed tiles in order.`;
    }
  }

  function handleCellInput(idx: number) {
    const outcome = engine.submitCell(idx);
    if (outcome.kind === 'ignored') {
      playTone(210, 'sine', 0.05);
      return;
    }

    const cell = cells[idx];
    const badge = cell?.querySelector<HTMLElement>('.step-badge');

    if (outcome.kind === 'step-ok') {
      cell?.classList.add('hit');
      if (badge) badge.textContent = String(outcome.step);
      playTone(440 + outcome.step * 60, 'sine', 0.1);
      syncHud();
      if (statusEl) {
        statusEl.textContent = `Step ${outcome.step} of ${outcome.total} locked in.`;
      }
      return;
    }

    if (outcome.kind === 'wave-cleared') {
      cell?.classList.add('hit');
      if (badge) badge.textContent = String(engine.getSequence().length);
      playTone(660, 'triangle', 0.22);
      syncHud();
      if (statusEl) {
        statusEl.textContent = `Wave ${outcome.completedWave} resolved! Preparing Wave ${outcome.nextWave} (${outcome.nextLength} tiles)...`;
      }
      const nextSeq = engine.rollWaveSequence();
      setTimeout(() => {
        void playTelegraphSequence(nextSeq);
      }, 900);
      return;
    }

    if (outcome.kind === 'campaign-cleared') {
      cell?.classList.add('hit');
      if (badge) badge.textContent = String(engine.getSequence().length);
      playTone(784, 'triangle', 0.28);
      syncHud();
      if (statusEl) {
        statusEl.textContent = `Perfect 7-tile recall! All ${outcome.totalWaves} waves cleared (Streak: ${outcome.streak}).`;
      }
      if (startBtn) startBtn.textContent = '↻ Play Again';
      window.dispatchEvent(
        new CustomEvent('portfolio:track', {
          detail: { event: 'minigame-cleared', meta: `streak-${outcome.streak}`, ts: Date.now() },
        }),
      );
      return;
    }

    if (outcome.kind === 'disrupted') {
      cell?.classList.add('miss');
      const expCell = cells[outcome.expectedCell];
      expCell?.classList.add('telegraph');
      const expBadge = expCell?.querySelector<HTMLElement>('.step-badge');
      if (expBadge) expBadge.textContent = String(outcome.failedAtStep);
      playTone(110, 'sawtooth', 0.25);
      syncHud();
      if (statusEl) {
        const { row, col } = TelegraphEngine.cellToCoord(outcome.expectedCell);
        statusEl.textContent = `Telegraph missed at step ${outcome.failedAtStep} (expected Row ${row}, Col ${col}). Press Retry.`;
      }
      if (startBtn) startBtn.textContent = '↻ Retry from Wave 1';
    }
  }

  cells.forEach((cell, idx) => {
    cell.addEventListener('click', () => handleCellInput(idx));
    cell.addEventListener('keydown', (e) => {
      const row = Math.floor(idx / 4);
      const col = idx % 4;
      let next = idx;
      if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') next = row * 4 + ((col + 1) % 4);
      else if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') next = row * 4 + ((col + 3) % 4);
      else if (e.key === 'ArrowDown' || e.key === 's' || e.key === 'S') next = ((row + 1) % 4) * 4 + col;
      else if (e.key === 'ArrowUp' || e.key === 'w' || e.key === 'W') next = ((row + 3) % 4) * 4 + col;
      else return;
      e.preventDefault();
      cells[next]?.focus();
    });
  });

  startBtn?.addEventListener('click', () => {
    startBtn.textContent = '↻ Restart';
    const seq = engine.startCampaign();
    void playTelegraphSequence(seq);
  });

  hintBtn?.addEventListener('click', () => {
    if (engine.useForecastHint()) {
      void playTelegraphSequence(engine.getSequence());
    }
  });

  muteBtn?.addEventListener('click', () => {
    muted = !muted;
    muteBtn.setAttribute('aria-pressed', String(muted));
    muteBtn.textContent = muted ? 'SFX: OFF' : 'SFX: ON';
  });
</script>


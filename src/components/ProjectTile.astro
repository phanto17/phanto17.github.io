---
/**
 * One tile of the overview's project bento (R4), as its place on the map (P4): a map label (.tag) in
 * the project's accent, with the map's own label ("Location 03 · genre") over the cover. When the
 * project has a `clip` (an R7 WebM loop) the tile crossfades to it on hover or focus, otherwise the
 * cover just lifts. Hovering one tile dims its siblings. The cover and title keep the transition names
 * that morph into the write-up.
 */
import type { CollectionEntry } from 'astro:content';
import { projectView } from '../lib/project-view';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
  /** Column span in the six-column bento. */
  span: 2 | 3 | 4;
  /** "Location 03 · 2D dungeon crawler / roguelite" (locationEyebrow). */
  eyebrow: string;
}
const { project, index, span, eyebrow } = Astro.props;
const d = project.data;
const href = `/projects/${project.id}/`;
const cover = d.media[0];
const view = projectView(d);
---

<article class="tile tag" data-reveal data-tilt data-tilt-max="2" data-tile style={`--reveal-delay:${index};--span:${span};--acc:${d.world.accent}`}>
  <!-- The map's label for this place, pinned over the cover as it hangs over the diorama on the map. -->
  <p class="tile-label tag eyebrow" transition:name={`eyebrow-${project.id}`}><i class="diamond is-done" aria-hidden="true"></i>{eyebrow}</p>
  <!-- transition:name pairs this cover with the subpage hero figure: it morphs across the page change. -->
  <a class="tile-cover crt-frame" href={href} aria-label={`${d.title} write-up`} transition:name={`cover-${project.id}`}>
    {
      cover?.src ? (
        <img src={cover.src} alt="" width="960" height="540" loading="lazy" decoding="async" />
      ) : (
        <span class="placeholder">[ image TODO ]</span>
      )
    }
    {d.clip && <video class="tile-clip" src={d.clip} muted loop playsinline preload="none" aria-hidden="true" data-tile-clip></video>}
  </a>
  <div class="tile-body">
    <p class="tile-meta meta-row">
      <span>{view.period}</span><span>{d.engine}</span>
    </p>
    <h3><a href={href} transition:name={`title-${project.id}`}>{d.title}</a></h3>
    <p class="muted">{d.summary}</p>
    {d.highlights.length > 0 && <p class="meta tile-high"><b>{d.highlights.join(' · ')}</b></p>}
    <div class="tile-actions">
      {
        view.live ? (
          <a class="pill play" href={view.live.href}>
            {view.live.label}
          </a>
        ) : (
          <span class="pill wip">{view.status}</span>
        )
      }
      <a class="pill" href={href}>
        write-up →
      </a>
      {
        d.githubUrl && (
          <a class="pill" href={d.githubUrl}>
            source ↗
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .tile {
    grid-column: span var(--span, 3);
    display: flex;
    flex-direction: column;
    min-width: 0;
    position: relative;
    overflow: hidden;
    transition:
      opacity 0.25s ease,
      background-color 0.25s ease,
      border-color 0.25s ease;
  }
  .tile:hover,
  .tile:focus-within {
    background: var(--surface);
    border-color: var(--acc-ui);
  }
  .tile-label {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 7px;
    max-width: calc(100% - 24px);
    margin: 0;
    padding: 5px 9px;
    /* The cover link under it takes the hover and the click. */
    pointer-events: none;
  }
  .tile-cover {
    display: block;
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: linear-gradient(160deg, var(--surface-2), var(--bg) 60%);
    border-radius: 0;
    box-shadow: none;
  }
  .tile[style*='--span:2'] .tile-cover {
    aspect-ratio: 4 / 3;
  }
  .tile-cover img,
  .tile-clip {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    inset: 0;
    transition: transform 0.6s var(--ease-out-expo), opacity 0.35s ease;
  }
  .tile:hover .tile-cover img,
  .tile:focus-within .tile-cover img {
    transform: scale(1.04);
  }
  .tile-clip {
    opacity: 0;
    z-index: 1;
  }
  .tile.is-playing .tile-clip {
    opacity: 1;
  }
  .placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-3);
  }
  .tile-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 18px 18px;
    flex: 1;
  }
  .tile-meta {
    gap: 6px 12px;
    margin: 0;
  }
  h3 {
    margin: 2px 0 2px;
    font-size: 26px;
  }
  .tile[style*='--span:4'] h3 {
    font-size: 32px;
  }
  h3 a {
    color: var(--text);
  }
  h3 a:hover {
    color: color-mix(in srgb, var(--acc-ui) var(--acc-ink), var(--text));
  }
  .tile-body > p.muted {
    margin: 0;
    font-size: 15px;
  }
  .tile-high {
    margin: 2px 0 0;
  }
  .tile-high b {
    color: color-mix(in srgb, var(--acc-ui) var(--acc-ink), var(--text));
  }
  .tile-actions {
    margin-top: auto;
    padding-top: 4px;
  }
  @media (max-width: 980px) {
    .tile {
      grid-column: span 3;
    }
    .tile[style*='--span:4'] h3 {
      font-size: 26px;
    }
  }
  @media (max-width: 760px) {
    .tile {
      grid-column: span 6;
    }
    .tile-cover {
      aspect-ratio: 16 / 9 !important;
    }
  }
</style>

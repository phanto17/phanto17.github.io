---
/**
 * One tile of the home page's project bento (R4). The cover fills the tile; when the project has a
 * `clip` (an R7 WebM loop) the tile crossfades to it on hover or focus, otherwise the cover just
 * lifts. Hovering one tile dims its siblings (a pattern from the R8 notes). The cover and title keep
 * the transition names that morph into the project page.
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
  /** Column span in the six-column bento. */
  span: 2 | 3 | 4;
}
const { project, index, span } = Astro.props;
const d = project.data;
const href = `/projects/${project.id}/`;
const cover = d.media[0];
const statusLabel = {
  playable: '▶ play on itch.io',
  released: '↓ download on GitHub',
  'in-progress': 'build in progress',
  planned: 'rework planned',
}[d.status];
const liveUrl = d.status === 'playable' ? d.itchUrl : d.status === 'released' ? d.downloadUrl : undefined;
const numStr = String(index + 1).padStart(2, '0');
const period = `${d.dates.start}${d.dates.end ? ` – ${d.dates.end}` : ' – now'}`;
---

<article class="tile" data-reveal data-tilt data-tilt-max="2" data-tile style={`--reveal-delay:${index};--span:${span}`}>
  <div class="crt-win-bar" aria-hidden="true">
    <span>[■] CH_{numStr} // {project.id.toUpperCase()}.{d.kind === 'tool' ? 'JAR' : 'WASM'}</span>
    <span class="win-status">● {d.status.toUpperCase()}</span>
  </div>
  <!-- transition:name pairs this cover with the subpage hero figure: it morphs across the page change. -->
  <a class="tile-cover crt-frame" href={href} aria-label={`${d.title} write-up`} transition:name={`cover-${project.id}`}>
    {
      cover?.src ? (
        <img src={cover.src} alt="" width="960" height="540" loading="lazy" decoding="async" />
      ) : (
        <span class="placeholder">[ image TODO ]</span>
      )
    }
    {d.clip && <video class="tile-clip" src={d.clip} muted loop playsinline preload="none" aria-hidden="true" data-tile-clip></video>}
    <span class="tile-num" aria-hidden="true">{numStr}</span>
  </a>
  <div class="tile-body">
    <p class="tile-meta">
      <span class="genre">{d.genre}</span>
      <span class="date">{period}</span>
    </p>
    <h3><a href={href} transition:name={`title-${project.id}`}>{d.title}</a></h3>
    <p class="muted">{d.summary}</p>
    {d.highlights.length > 0 && <p class="meta tile-high"><b>{d.highlights.join(' · ')}</b></p>}
    <div class="tile-actions">
      {
        liveUrl ? (
          <a class="pill play" href={liveUrl}>
            {statusLabel}
          </a>
        ) : (
          <span class="pill wip">{statusLabel}</span>
        )
      }
      <a class="pill" href={href}>
        write-up →
      </a>
      {
        d.githubUrl && (
          <a class="pill" href={d.githubUrl}>
            source ↗
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .tile {
    grid-column: span var(--span, 3);
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--surface);
    border: 1.5px solid var(--umber);
    border-radius: var(--r-md);
    box-shadow: var(--card-depth);
    overflow: hidden;
    transition:
      opacity 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }
  .tile:hover,
  .tile:focus-within {
    border-color: var(--coral);
    box-shadow: var(--card-depth-hover);
  }
  .crt-win-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    background: var(--surface-2);
    border-bottom: 1px solid var(--umber);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--steel);
    white-space: nowrap;
    overflow: hidden;
  }
  .win-status {
    color: var(--mint);
  }
  .tile-cover {
    display: block;
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: linear-gradient(160deg, var(--surface-2), var(--bg) 60%);
    border-radius: 0;
    box-shadow: none;
  }
  .tile[style*='--span:2'] .tile-cover {
    aspect-ratio: 4 / 3;
  }
  .tile-cover img,
  .tile-clip {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    inset: 0;
    transition: transform 0.6s var(--ease-out-expo), opacity 0.35s ease;
  }
  .tile:hover .tile-cover img,
  .tile:focus-within .tile-cover img {
    transform: scale(1.04);
  }
  .tile-clip {
    opacity: 0;
    z-index: 1;
  }
  .tile.is-playing .tile-clip {
    opacity: 1;
  }
  .tile-num {
    position: absolute;
    right: 14px;
    bottom: 10px;
    z-index: 3;
    font-family: var(--display);
    font-size: 44px;
    line-height: 1;
    font-weight: 700;
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
    color: var(--text);
    opacity: 0.85;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.7);
    transition: transform 0.35s var(--ease-out-expo), color 0.35s ease, font-variation-settings 0.35s ease;
  }
  .tile:hover .tile-num {
    color: var(--peach);
    transform: translateY(-3px) scale(1.06);
    font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 9;
  }
  .placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-3);
  }
  .tile-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 18px 18px;
    flex: 1;
  }
  .tile-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 12px;
    margin: 0;
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .tile-meta .genre {
    color: var(--gold);
  }
  .tile-meta .date {
    color: var(--steel);
  }
  h3 {
    margin: 2px 0 2px;
    font-size: 26px;
  }
  .tile[style*='--span:4'] h3 {
    font-size: 32px;
  }
  h3 a {
    color: var(--text);
  }
  h3 a:hover {
    color: var(--peach);
  }
  .tile-body > p.muted {
    margin: 0;
    font-size: 15px;
  }
  .tile-high {
    margin: 2px 0 0;
  }
  .tile-actions {
    margin-top: auto;
    padding-top: 4px;
  }
  @media (max-width: 900px) {
    .tile {
      grid-column: span 3;
    }
    .tile[style*='--span:4'] h3 {
      font-size: 26px;
    }
  }
  @media (max-width: 600px) {
    .tile {
      grid-column: span 6;
    }
    .tile-cover {
      aspect-ratio: 16 / 9 !important;
    }
  }
</style>

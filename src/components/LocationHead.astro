---
/**
 * An overview section's head as a location tag (D4): the diamond, "03 · The Lab" in the section's
 * accent (the section sets --acc and .accent), the h2 and its sub-head, and a key to the same place
 * on the map. It keeps the .section-head-bar class, so the kinetic heading (motion.ts) and the sticky
 * Projects head (base.css) work as before. The big outlined numerals are gone; the number lives here.
 */
interface Props {
  /** Section number, "01"–"06". */
  num: string;
  /** The place on the map ("Field Station"). */
  place: string;
  title: string;
  sub?: string;
  /** Where "On the map" goes: `/#<landmark>`, or the map itself. */
  mapHref: string;
}
const { num, place, title, sub, mapHref } = Astro.props;
---

<div class="section-head-bar loc-head" data-reveal>
  <div>
    <p class="eyebrow loc-head-line"><i class="diamond is-done" aria-hidden="true"></i>{num} · {place}</p>
    <h2>{title}</h2>
    {sub && <p class="sub-h">{sub}</p>}
  </div>
  <a class="btn hud-key loc-head-map" href={mapHref}>On the map →</a>
</div>

<style>
  .loc-head {
    border-bottom: 1px solid color-mix(in srgb, var(--acc-ui) var(--acc-edge), transparent);
  }
  .loc-head-line {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 8px;
  }
  .loc-head h2 {
    margin: 0;
  }
  /* Inside the map's Lab overlay the visitor is already on the map. */
  :global(.world-lab) .loc-head-map {
    display: none;
  }
</style>

---
import { TELEGRAPH_PORTAL_NODES } from '../scripts/telegraph-engine';
import InteractivePanel from './InteractivePanel.astro';
---

<!-- Non-Linear Exploratory Portal Grid (NonLinearLayout + InteractivePanel) -->
<div class="nonlinear-section" data-reveal style="--reveal-delay:1">
  <div class="nonlinear-header">
    <p class="kicker">Explore the ideas behind the game</p>
    <span class="meta">EXPLORED: <b id="tg-portal-progress">1</b>/{TELEGRAPH_PORTAL_NODES.length} NODES</span>
  </div>

  <div
    id="tg-portal-grid"
    class="nonlinear-grid"
    role="group"
    aria-label="Telegraph Recall non-linear field note portals"
  >
    {
      TELEGRAPH_PORTAL_NODES.map((node, index) => (
        <InteractivePanel node={node} active={index === 0} />
      ))
    }
  </div>

  <!-- Dynamic Portal Inspector Scene -->
  <div
    id="tg-portal-inspector"
    class="portal-inspector crt-frame"
    role="region"
    aria-labelledby="inspector-title"
    aria-live="polite"
    data-crt-ripple
  >
    <div class="inspector-bar">
      <span id="inspector-code" class="meta"><b>{TELEGRAPH_PORTAL_NODES[0].code}</b> · {TELEGRAPH_PORTAL_NODES[0].tag}</span>
      <span class="meta">Choose a note to explore</span>
    </div>
    <h3 id="inspector-title" class="inspector-title" tabindex="-1">{TELEGRAPH_PORTAL_NODES[0].title}</h3>
    <p id="inspector-detail" class="inspector-detail">{TELEGRAPH_PORTAL_NODES[0].detail}</p>
    <div class="inspector-footer">
      <a
        id="inspector-link"
         class="btn"
        href={TELEGRAPH_PORTAL_NODES[0].projectHref ?? '#tg-grid'}
      >
        {TELEGRAPH_PORTAL_NODES[0].projectLabel ?? 'Jump to 4×4 Tactical Board ↓'}
      </a>
      <button type="button" id="inspector-open-stage3" class="btn">
        Open in CRT Stage 03 Modal ↗
      </button>
    </div>
  </div>
</div>

<style>
  /* Non-Linear Exploratory Portal Grid */
  .nonlinear-section {
    margin-bottom: 32px;
  }
  .nonlinear-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }
  .nonlinear-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 14px;
  }
  @media (max-width: 900px) {
    .nonlinear-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 540px) {
    .nonlinear-grid {
      grid-template-columns: 1fr;
    }
  }
  /* Portal Inspector */
  .portal-inspector {
    background: var(--surface);
    border: 1px solid var(--umber);
    border-radius: var(--r-md);
    padding: 18px 22px;
    position: relative;
    overflow: hidden;
  }
  .inspector-bar {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
    border-bottom: var(--line);
    padding-bottom: 8px;
    margin-bottom: 12px;
  }
  .inspector-title {
    font-family: var(--display);
    font-size: 20px;
    margin: 0 0 8px;
    color: var(--gold);
  }
  .inspector-detail {
    margin: 0 0 14px;
    color: var(--text-2);
    max-width: 78ch;
  }
  .inspector-footer {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  /* Per-Click Phosphor Ripple */
  :global([data-crt-ripple]) {
    position: relative;
    overflow: hidden;
  }
</style>

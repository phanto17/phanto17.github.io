---
/**
 * Nonlinear notes: a project's technical breakdown.
 *
 * Wide screens (≥ 861px, R5 "sticky split"): the notes are numbered steps in a scrolling left column
 * and a pinned right pane shows one visual per step (a screenshot, the note's first code block, or
 * the shove visualiser), swapped as the reader scrolls. Narrow screens: the explorable grid of cards
 * (InteractivePanel) with a reading pane, one note at a time, as before; the visuals move into their
 * notes. Progressive enhancement: the server renders every note as a plain section, so without
 * JavaScript the write-up reads top to bottom. Deep links to any heading inside a note open that note.
 */
import InteractivePanel from './InteractivePanel.astro';
import Figure from './Figure.astro';
import type { WriteUpPlan } from '../lib/notes';

interface Props {
  /** The write-up plan (src/lib/notes.ts planWriteUp): the notes, each with its visual. */
  plan: WriteUpPlan;
  title: string;
}
const { plan, title } = Astro.props;
const { notes } = plan;
---

<div class="notes" data-notes>
  <div class="notes-head" data-notes-ui hidden>
    <p class="kicker">Explore the breakdown</p>
    <span class="meta notes-progress">EXPLORED: <b data-notes-progress>1</b>/{notes.length} NOTES</span>
    <button type="button" class="btn notes-mode" data-notes-mode aria-pressed="false">Read as one page</button>
  </div>

  <div class="notes-grid" style={`--note-cols:${notes.length === 4 ? 2 : 3}`} role="group" aria-label={`${title}: technical notes`} data-notes-ui hidden>
    {notes.map((note, i) => <InteractivePanel node={note} active={i === 0} kind="note" />)}
  </div>

  <div class="notes-pane" data-notes-pane>
    {
      notes.map((note, i) => (
        <section class="note" id={note.id} data-note aria-labelledby={note.headingId}>
          <p class="note-bar meta" data-notes-ui hidden>
            <span>
              <b>{note.code}</b> · {note.tag}
            </span>
            <span>
              Note {i + 1} of {notes.length}
            </span>
          </p>
          <Fragment set:html={note.headingHtml} />
          <!-- The note's visual renders here, after its heading, so it reads in place without JavaScript and on
               narrow screens; on wide screens the script moves it into the pinned pane below. -->
          <figure class="visual" data-visual={note.id} data-visual-kind={note.visual.kind} data-lenis-prevent>
            {note.visual.kind === 'code' && <Fragment set:html={note.visual.html} />}
            {note.visual.kind === 'image' && <Figure type="image" src={note.visual.src} alt={note.visual.alt ?? ''} caption={note.visual.caption} />}
            {note.visual.kind === 'widget' && <slot name="widget" />}
            <figcaption class="visual-cap meta">
              <b>{note.code}</b> · {note.title}
            </figcaption>
          </figure>
          <Fragment set:html={note.bodyHtml} />
          <div class="note-nav" data-notes-ui hidden>
            {i > 0 ? (
              <button type="button" class="btn" data-note-step={notes[i - 1].id}>
                ← {notes[i - 1].title}
              </button>
            ) : (
              <span />
            )}
            {i < notes.length - 1 && (
              <button type="button" class="btn" data-note-step={notes[i + 1].id}>
                {notes[i + 1].title} →
              </button>
            )}
          </div>
        </section>
      ))
    }
  </div>

  <!-- The pinned pane of the wide layout: empty until the script moves the notes' visuals into it. -->
  <div class="notes-visuals" data-notes-visuals hidden></div>
</div>

<script>
  import { onPage } from '../scripts/page';
  import { prefs } from '../scripts/prefs';

  const WIDE = '(min-width: 861px)';

  // The reading mode is a visitor preference (src/scripts/prefs.ts, row `notes`).
  const readMode = () => prefs.get('notes');
  const saveMode = (mode: 'explore' | 'page') => prefs.set('notes', mode);

  function setup(root: HTMLElement, signal: AbortSignal) {
    const notes = Array.from(root.querySelectorAll<HTMLElement>('[data-note]'));
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-note-tab]'));
    const modeBtn = root.querySelector<HTMLButtonElement>('[data-notes-mode]');
    const progress = root.querySelector<HTMLElement>('[data-notes-progress]');
    const visualsBox = root.querySelector<HTMLElement>('[data-notes-visuals]');
    const visuals = Array.from(root.querySelectorAll<HTMLElement>('[data-visual]'));
    const wide = window.matchMedia(WIDE);
    const explored = new Set<string>();
    let mode = readMode();
    let layout: 'split' | 'stack' = wide.matches && visuals.length > 0 ? 'split' : 'stack';
    let active = notes[0]?.id ?? '';
    let io: IntersectionObserver | null = null;

    root.querySelectorAll<HTMLElement>('[data-notes-ui]').forEach((el) => (el.hidden = false));

    // The visuals are rendered inside their notes (after the heading); on wide screens they move into
    // the pinned pane and come back when the layout narrows, so they are reachable either way.
    const placeVisuals = () => {
      if (!visualsBox) return;
      visuals.forEach((v) => {
        if (layout === 'split') {
          visualsBox.appendChild(v);
          return;
        }
        const note = document.getElementById(v.dataset.visual ?? '');
        const h3 = note?.querySelector('h3');
        if (h3 && v.parentElement !== note) h3.insertAdjacentElement('afterend', v);
      });
      visualsBox.hidden = layout !== 'split';
    };

    const setVisual = (id: string) => {
      visuals.forEach((v) => v.classList.toggle('is-active', v.dataset.visual === id));
      notes.forEach((n) => n.classList.toggle('is-current', n.id === id));
    };

    const paint = () => {
      const exploring = layout === 'stack' && mode === 'explore';
      root.classList.toggle('is-explorer', exploring);
      root.classList.toggle('is-split', layout === 'split');
      notes.forEach((note) => (note.hidden = exploring && note.id !== active));
      tabs.forEach((tab) => {
        const id = tab.dataset.noteTab ?? '';
        const on = exploring && id === active;
        tab.setAttribute('aria-pressed', String(on));
        tab.classList.toggle('is-active', on);
        tab.classList.toggle('is-explored', explored.has(id));
        const status = tab.querySelector<HTMLElement>('.panel-status');
        if (status) status.textContent = on ? '● ACTIVE' : explored.has(id) ? '✓ READ' : '○ NOTE';
      });
      if (progress) progress.textContent = String(explored.size);
      if (modeBtn) {
        modeBtn.setAttribute('aria-pressed', String(!exploring));
        modeBtn.textContent = exploring ? 'Read as one page' : 'Explore as notes';
      }
      if (layout === 'split') setVisual(active);
    };

    // Split layout: the note under the upper third of the viewport drives the pane.
    const watchSteps = () => {
      io?.disconnect();
      io = null;
      if (layout !== 'split' || !('IntersectionObserver' in window)) return;
      io = new IntersectionObserver(
        (entries) => {
          const hit = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
          if (!hit) return;
          active = hit.target.id;
          explored.add(active);
          setVisual(active);
        },
        { rootMargin: '-30% 0px -55% 0px', threshold: 0 },
      );
      notes.forEach((n) => io!.observe(n));
    };

    const heading = (id: string) => document.getElementById(id)?.querySelector<HTMLElement>('h3') ?? null;
    const replaceHash = (id: string) => {
      const h = heading(id);
      if (h?.id) history.replaceState(history.state, '', `#${h.id}`);
    };

    const open = (id: string, opts: { focus?: boolean; scroll?: boolean } = {}) => {
      if (!notes.some((n) => n.id === id)) return;
      active = id;
      explored.add(id);
      paint();
      const target = document.getElementById(id);
      if (target && layout === 'stack' && mode === 'explore') {
        target.classList.remove('is-entering');
        void target.offsetWidth;
        target.classList.add('is-entering');
      }
      const h = heading(id);
      if (opts.focus && h) {
        h.tabIndex = -1;
        h.focus({ preventScroll: true });
      }
      if (opts.scroll || layout === 'split') {
        (layout === 'stack' && mode === 'explore' ? root : target)?.scrollIntoView({ block: 'start' });
      }
    };

    /** Open the note that holds the element the URL hash points at; true when one was found. */
    const fromHash = (): boolean => {
      const raw = decodeURIComponent(location.hash.slice(1));
      if (!raw) return false;
      const el = document.getElementById(raw);
      const note = el?.closest<HTMLElement>('[data-note]');
      if (!el || !note || !root.contains(note)) return false;
      open(note.id);
      el.scrollIntoView({ block: 'start' });
      return true;
    };

    const applyLayout = () => {
      layout = wide.matches && visuals.length > 0 ? 'split' : 'stack';
      placeVisuals();
      paint();
      watchSteps();
    };

    explored.add(active);
    applyLayout();
    fromHash();
    wide.addEventListener('change', applyLayout, { signal });

    tabs.forEach((tab) =>
      tab.addEventListener(
        'click',
        () => {
          const id = tab.dataset.noteTab ?? '';
          if (layout === 'stack' && mode === 'explore') {
            open(id);
            replaceHash(id);
          } else {
            active = id; // explore mode resumes on the last note picked
            explored.add(id);
            paint();
            document.getElementById(id)?.scrollIntoView({ block: 'start' });
            replaceHash(id);
          }
        },
        { signal },
      ),
    );
    root.querySelectorAll<HTMLButtonElement>('[data-note-step]').forEach((btn) =>
      btn.addEventListener(
        'click',
        () => {
          const id = btn.dataset.noteStep ?? '';
          open(id, { focus: true, scroll: root.getBoundingClientRect().top < 0 });
          replaceHash(id);
        },
        { signal },
      ),
    );
    modeBtn?.addEventListener(
      'click',
      () => {
        mode = mode === 'explore' ? 'page' : 'explore';
        saveMode(mode);
        paint();
        if (mode === 'explore' && layout === 'stack') open(active);
        modeBtn.focus();
      },
      { signal },
    );
    window.addEventListener('hashchange', fromHash, { signal });
    signal.addEventListener('abort', () => io?.disconnect());
  }

  onPage(({ signal }) => {
    document.querySelectorAll<HTMLElement>('[data-notes]').forEach((root) => setup(root, signal));
  });
</script>

<style>
  .notes {
    margin-top: 24px;
  }
  .notes-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-bottom: 12px;
  }
  .notes-head .kicker {
    margin: 0;
  }
  .notes-progress {
    flex: 1;
  }
  .notes-mode {
    font-size: 13px;
    padding: 6px 14px;
  }
  /* Balanced rows: four notes as 2 × 2, three or five as rows of three. */
  .notes-grid {
    display: grid;
    grid-template-columns: repeat(var(--note-cols, 3), minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 16px;
  }
  .notes-grid :global(.interactive-panel) {
    min-width: 0;
  }
  /* Explore mode: the pane takes the inspector's look and shows one note. */
  .notes.is-explorer .notes-pane {
    background: var(--surface);
    border: 1px solid var(--umber);
    border-radius: var(--r-md);
    padding: 18px 22px 22px;
  }
  .note-bar {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 4px;
    padding-bottom: 8px;
    border-bottom: var(--line);
  }
  .notes:not(.is-explorer) .note-bar {
    margin-top: 40px;
  }
  .notes.is-explorer .note :global(h3:first-of-type) {
    margin-top: 16px;
  }
  .note :global(h3:focus) {
    outline: none;
  }
  .note :global(h3:focus-visible) {
    outline: 2px solid var(--coral);
    outline-offset: 4px;
  }
  .note-nav {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .notes:not(.is-explorer) .note-nav {
    display: none;
  }
  .note-nav .btn {
    font-size: 13px;
    max-width: 100%;
    white-space: normal;
    text-align: left;
  }
  .note.is-entering {
    animation: note-in 260ms var(--ease-out-expo, cubic-bezier(0.22, 1, 0.36, 1)) both;
  }
  @keyframes note-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  /* ---- Visuals: in a note (narrow) they sit under the heading as a figure ---- */
  .visual {
    margin: 16px 0 20px;
    min-width: 0;
  }
  .visual :global(pre.astro-code) {
    margin: 0;
    max-height: min(60vh, 520px);
  }
  .visual-cap {
    display: none;
  }

  /* ---- Sticky split (≥ 861px): steps left, pinned pane right ---- */
  .notes.is-split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 44%);
    gap: 40px;
    align-items: start;
  }
  .notes.is-split .notes-head,
  .notes.is-split .notes-grid,
  .notes.is-split .note-nav {
    display: none;
  }
  .notes.is-split .notes-pane {
    min-width: 0;
  }
  .notes.is-split .note {
    scroll-margin-top: 96px;
    padding-bottom: 8px;
  }
  .notes.is-split .note-bar {
    margin-top: 40px;
    border-bottom-color: transparent;
    transition: color 0.3s ease;
  }
  .notes.is-split .note:first-child .note-bar {
    margin-top: 0;
  }
  .notes.is-split .note.is-current .note-bar b {
    color: var(--coral);
  }
  .notes.is-split .note:not(.is-current) {
    opacity: 0.82;
    transition: opacity 0.4s ease;
  }
  /* The note's own copy of a code block that the pane shows. */
  .notes.is-split .note :global([data-in-pane]),
  .notes.is-split .note :global(.code-block-wrap:has([data-in-pane])) {
    display: none;
  }
  .notes.is-split .notes-visuals {
    position: sticky;
    top: 92px;
    display: grid;
    min-width: 0;
  }
  .notes.is-split .visual {
    grid-area: 1 / 1;
    margin: 0;
    opacity: 0;
    transform: translateY(10px);
    pointer-events: none;
    transition:
      opacity 0.45s ease,
      transform 0.5s var(--ease-out-expo, cubic-bezier(0.22, 1, 0.36, 1));
  }
  .notes.is-split .visual.is-active {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .notes.is-split .visual-cap {
    display: block;
    margin-top: 10px;
  }
  .notes.is-split .visual :global(pre.astro-code) {
    max-height: calc(100vh - 200px);
    overflow: auto;
  }

  @media (max-width: 700px) {
    .notes-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 540px) {
    .notes-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }
    /* Compact cards on phones so the pane is not pushed a screen down. */
    .notes-grid :global(.panel-summary) {
      display: none;
    }
    .notes-grid :global(.interactive-panel) {
      padding: 10px 14px;
      gap: 4px;
    }
    .notes.is-explorer .notes-pane {
      padding: 14px 14px 18px;
    }
  }
</style>

---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Path of an og image under /public, optional. */
  image?: string;
  /** Keep the page out of search results (404, style-guide). */
  noindex?: boolean;
  /** Optional JSON-LD structured data object or graph. */
  schema?: Record<string, unknown>;
}
const {
  title,
  description = site.description,
  image = '/media/og/default.jpg',
  noindex = false,
  schema,
} = Astro.props;
const ogImage = new URL(image, site.url).toString();
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).toString();

const defaultSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.title,
  url: site.url,
  email: `mailto:${site.email}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Poznań',
    addressCountry: 'PL',
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Collegium Da Vinci',
  },
  sameAs: [site.github, site.youtube, 'https://phanto-official.itch.io'],
};
const jsonLd = schema ?? defaultSchema;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="theme-color" content="#1a1713" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <!-- Self-hosted WOFF2 preloads (zero third-party font requests, CLS 0.00) -->
    <link rel="preload" href="/fonts/fraunces-normal-400-700-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/dm-sans-normal-400-600-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/dm-mono-normal-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      (function () {
        try {
          var savedTheme = localStorage.getItem('portfolio-theme');
          if (savedTheme === 'prism' || savedTheme === 'paper' || savedTheme === 'crt') {
            document.documentElement.setAttribute('data-theme', savedTheme);
          }
          var savedMotion = localStorage.getItem('portfolio-motion');
          var sysReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (savedMotion === 'reduced' || (!savedMotion && sysReduced)) {
            document.documentElement.setAttribute('data-motion', 'reduced');
          } else {
            document.documentElement.classList.add('js-motion');
          }
        } catch (e) {
          document.documentElement.classList.add('js-motion');
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div id="cursor-reticle" class="cursor-reticle" aria-hidden="true"></div>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // 1. Scroll-triggered Fade-In & Stagger Choreography
      const initScrollReveal = () => {
        const els = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
        if (!('IntersectionObserver' in window) || document.documentElement.getAttribute('data-motion') === 'reduced') {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      };
      initScrollReveal();

      // 2. 3D Perspective Tilt & Specular Spotlight on [data-tilt] cards
      const isMotionAllowed = () =>
        document.documentElement.getAttribute('data-motion') !== 'reduced' &&
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((card) => {
        const maxDeg = Number(card.dataset.tiltMax ?? 4.5);
        card.addEventListener('pointermove', (e) => {
          if (!isMotionAllowed() || e.pointerType === 'touch') return;
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          const nx = x / rect.width - 0.5;
          const ny = y / rect.height - 0.5;
          card.style.setProperty('--rx', `${(-ny * maxDeg * 2).toFixed(2)}deg`);
          card.style.setProperty('--ry', `${(nx * maxDeg * 2).toFixed(2)}deg`);
          card.style.setProperty('--mx', `${x.toFixed(0)}px`);
          card.style.setProperty('--my', `${y.toFixed(0)}px`);
          card.style.setProperty('--glare-opacity', '1');
          card.style.setProperty('--lift', '-3px');
        });
        card.addEventListener('pointerleave', () => {
          card.style.setProperty('--rx', '0deg');
          card.style.setProperty('--ry', '0deg');
          card.style.setProperty('--glare-opacity', '0');
          card.style.setProperty('--lift', '0px');
        });
      });

      // 3. Magnetic Micro-Interaction on .btn elements
      document.querySelectorAll<HTMLElement>('.btn').forEach((btn) => {
        btn.addEventListener('pointermove', (e) => {
          if (!isMotionAllowed() || e.pointerType === 'touch') return;
          const rect = btn.getBoundingClientRect();
          const dx = (e.clientX - (rect.left + rect.width / 2)) * 0.18;
          const dy = (e.clientY - (rect.top + rect.height / 2)) * 0.22;
          btn.style.setProperty('--bx', `${dx.toFixed(1)}px`);
          btn.style.setProperty('--by', `${dy.toFixed(1)}px`);
        });
        btn.addEventListener('pointerleave', () => {
          btn.style.setProperty('--bx', '0px');
          btn.style.setProperty('--by', '0px');
        });
      });

      // 4. Custom Tactical Cursor Reticle (fine pointer only)
      const reticle = document.getElementById('cursor-reticle');
      if (reticle && window.matchMedia('(pointer: fine)').matches) {
        window.addEventListener(
          'pointermove',
          (e) => {
            if (!isMotionAllowed()) return;
            const size = reticle.classList.contains('is-hover') ? 22 : 14;
            reticle.style.transform = `translate3d(${e.clientX - size}px, ${e.clientY - size}px, 0)`;
          },
          { passive: true },
        );
        document.addEventListener('mouseover', (e) => {
          const hit = (e.target as HTMLElement | null)?.closest('a, button, summary, [data-tilt]');
          reticle.classList.toggle('is-hover', Boolean(hit));
        });
      }

      // 5. Privacy-first, cookieless telemetry dispatcher for outbound & portfolio actions
      document.addEventListener('click', (e) => {
        const target = (e.target as HTMLElement | null)?.closest<HTMLElement>('[data-track]');
        if (!target) return;
        const eventName = target.dataset.track;
        const eventMeta = target.dataset.trackMeta ?? '';
        if (!eventName) return;
        window.dispatchEvent(
          new CustomEvent('portfolio:track', {
            detail: { event: eventName, meta: eventMeta, ts: Date.now() },
          }),
        );
        const w = window as unknown as {
          plausible?: (ev: string, opts?: { props: Record<string, string> }) => void;
          goatcounter?: { count?: (opts: { path: string; title: string; event: boolean }) => void };
        };
        if (typeof w.plausible === 'function') {
          w.plausible(eventName, { props: { target: eventMeta } });
        }
        if (w.goatcounter && typeof w.goatcounter.count === 'function') {
          w.goatcounter.count({ path: `event/${eventName}/${eventMeta}`, title: eventName, event: true });
        }
      });
    </script>
  </body>
</html>

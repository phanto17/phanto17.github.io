---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ScrollRail, { type RailSection } from '../components/ScrollRail.astro';
import { site, PERSON_ID } from '../data/site';
import prefsBoot from '../scripts/generated/prefs-boot.js?raw';

interface Props {
  title?: string;
  description?: string;
  /** Path of an og image under /public, optional. */
  image?: string;
  /** Keep the page out of search results (404, style-guide, overview). */
  noindex?: boolean;
  /** Extra JSON-LD nodes for this page (no @context). */
  schema?: Record<string, unknown>[];
  /** Project accent colour applied inside <main id="main"> via .accent wrapper. */
  accent?: string;
  /** Desktop right-rail section anchors. */
  sections?: readonly RailSection[];
}

const {
  title,
  accent,
  sections = [],
  description = site.description,
  image = '/media/og/default.jpg',
  noindex = false,
  schema,
} = Astro.props;

const ogImage = new URL(image, site.url).toString();
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).toString();

const personNode = {
  '@type': 'Person',
  '@id': PERSON_ID,
  name: site.name,
  jobTitle: site.title,
  url: site.url,
  email: `mailto:${site.email}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Poznań',
    addressCountry: 'PL',
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Collegium Da Vinci',
  },
  sameAs: [site.github, site.youtube, site.itch],
};

const websiteNode = {
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  url: `${site.url}/`,
  name: site.name,
  inLanguage: 'en',
  publisher: { '@id': PERSON_ID },
};

const jsonLd = { '@context': 'https://schema.org', '@graph': [personNode, websiteNode, ...(schema ?? [])] };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="theme-color" id="theme-color" content="#1a1713" transition:persist="theme-color" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preload" href="/fonts/fraunces-normal-400-700-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/dm-sans-normal-400-600-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/dm-mono-normal-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\u003c')} />}
    <ClientRouter />
    <script is:inline set:html={prefsBoot} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <canvas id="signal-field" class="signal-field" aria-hidden="true" transition:persist="signal-field"></canvas>
    <div id="cursor-reticle" class="cursor-reticle" aria-hidden="true" transition:persist="cursor-reticle"></div>
    <Nav />
    <main id="main">
      {
        accent ? (
          <div class="accent" style={`--acc: ${accent}`}>
            <slot />
          </div>
        ) : (
          <slot />
        )
      }
    </main>
    <ScrollRail sections={sections} />
    <Footer />
    <script>
      import type { TransitionBeforeSwapEvent } from 'astro:transitions/client';
      import { CARRIED_ATTRIBUTES, prefs } from '../scripts/prefs';
      import { onPage, shared, trackHover } from '../scripts/page';
      import { sound } from '../scripts/sound';

      const root = document.documentElement;
      const isMotionAllowed = () => prefs.isMotionAllowed();

      const initScrollReveal = () => {
        shared.reveal?.io.disconnect();
        const els = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
        if (!('IntersectionObserver' in window) || !isMotionAllowed()) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
        shared.reveal = { io, els };
      };

      onPage(initScrollReveal);

      const restTilt = (card: HTMLElement) => {
        card.style.setProperty('--rx', '0deg');
        card.style.setProperty('--ry', '0deg');
        card.style.setProperty('--glare-opacity', '0');
        card.style.setProperty('--lift', '0px');
      };
      trackHover('[data-tilt]', {
        move: (card, e) => {
          if (!isMotionAllowed() || e.pointerType === 'touch') return;
          const maxDeg = Number(card.dataset.tiltMax ?? 4.5);
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          const nx = x / rect.width - 0.5;
          const ny = y / rect.height - 0.5;
          card.style.setProperty('--rx', `${(-ny * maxDeg * 2).toFixed(2)}deg`);
          card.style.setProperty('--ry', `${(nx * maxDeg * 2).toFixed(2)}deg`);
          card.style.setProperty('--mx', `${x.toFixed(0)}px`);
          card.style.setProperty('--my', `${y.toFixed(0)}px`);
          card.style.setProperty('--glare-opacity', '1');
          card.style.setProperty('--lift', '-3px');
        },
        leave: restTilt,
      });

      const restMagnetic = (btn: HTMLElement) => {
        btn.style.setProperty('--bx', '0px');
        btn.style.setProperty('--by', '0px');
      };
      trackHover('.btn', {
        move: (btn, e) => {
          if (!isMotionAllowed() || e.pointerType === 'touch' || btn.matches(':disabled')) return;
          const rect = btn.getBoundingClientRect();
          const dx = (e.clientX - (rect.left + rect.width / 2)) * 0.12;
          const dy = (e.clientY - (rect.top + rect.height / 2)) * 0.15;
          btn.style.setProperty('--bx', `${dx.toFixed(1)}px`);
          btn.style.setProperty('--by', `${dy.toFixed(1)}px`);
        },
        leave: restMagnetic,
      });

      document.addEventListener('astro:before-swap', (event) => {
        const next = (event as TransitionBeforeSwapEvent).newDocument.documentElement;
        ['class', ...CARRIED_ATTRIBUTES].forEach((name) => {
          const value = root.getAttribute(name);
          if (value === null) next.removeAttribute(name);
          else next.setAttribute(name, value);
        });
      });

      prefs.onChange('motion', () => {
        initScrollReveal();
        if (isMotionAllowed()) return;
        document.querySelectorAll<HTMLElement>('[data-tilt]').forEach(restTilt);
        document.querySelectorAll<HTMLElement>('.btn').forEach(restMagnetic);
      });

      let motionBooted = false;
      const bootMotion = () => {
        const nav = navigator as Navigator & { connection?: { saveData?: boolean } };
        if (motionBooted || nav.connection?.saveData || !isMotionAllowed()) return;
        motionBooted = true;
        void import('../scripts/motion').then((m) => m.init());
      };
      if (document.readyState === 'complete') bootMotion();
      else window.addEventListener('load', bootMotion, { once: true });
      prefs.onChange('motion', bootMotion);

      const fieldCanvas = document.getElementById('signal-field') as HTMLCanvasElement | null;
      let field: Promise<typeof import('../scripts/field')> | null = null;
      const loadField = (canvas: HTMLCanvasElement) =>
        (field ??= import('../scripts/field').then((f) => {
          f.init(canvas);
          return f;
        }));
      onPage(({ signal }) => {
        const nav = navigator as Navigator & { connection?: { saveData?: boolean } };
        if (!fieldCanvas || nav.connection?.saveData) return;
        const show = () => void loadField(fieldCanvas).then((f) => f.setActive(true));
        if (document.readyState === 'complete') show();
        else window.addEventListener('load', show, { once: true, signal });
      });

      const reticle = document.getElementById('cursor-reticle');
      if (reticle && window.matchMedia('(pointer: fine)').matches) {
        window.addEventListener(
          'pointermove',
          (e) => {
            if (!isMotionAllowed()) return;
            const size = reticle.classList.contains('is-hover') ? 22 : 14;
            reticle.style.transform = `translate3d(${e.clientX - size}px, ${e.clientY - size}px, 0)`;
          },
          { passive: true },
        );
        document.addEventListener('mouseover', (e) => {
          const hit = (e.target as HTMLElement | null)?.closest('a, button, summary, [data-tilt]');
          reticle.classList.toggle('is-hover', Boolean(hit));
        });
      }

      const RIPPLE_HOSTS = '[data-crt-ripple], .btn, .pill';
      document.addEventListener('click', (e) => {
        const host = (e.target as HTMLElement | null)?.closest<HTMLElement>(RIPPLE_HOSTS);
        if (!host) return;
        sound.play('click');
        if (!isMotionAllowed()) return;
        const rect = host.getBoundingClientRect();
        const x = e.detail === 0 ? rect.width / 2 : e.clientX - rect.left;
        const y = e.detail === 0 ? rect.height / 2 : e.clientY - rect.top;
        const ripple = document.createElement('span');
        ripple.className = 'crt-click-ripple';
        ripple.style.left = `${x}px`;
        ripple.style.top = `${y}px`;
        host.appendChild(ripple);
        ripple.addEventListener('animationend', () => ripple.remove(), { once: true });
        setTimeout(() => ripple.remove(), 650);
      });
    </script>
  </body>
</html>

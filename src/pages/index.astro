---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Prism from '../components/Prism.astro';
import ProjectTile from '../components/ProjectTile.astro';
import TelegraphMiniGame from '../components/TelegraphMiniGame.astro';
import SignalLanding from '../components/SignalLanding.astro';
import SignalStamp from '../components/SignalStamp.astro';
import { site } from '../data/site';
import { activities, experience, education } from '../data/activities';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
/** Bento spans in a six-column grid: the first project wide, then a small one, then two halves. */
const spans: (2 | 3 | 4)[] = [4, 2, 3, 3];

const systemSpecs = [
  { label: 'RUNTIME', val: 'Unity 6 (URP) & C#' },
  { label: 'PRACTICE', val: 'Gameplay systems & automated tests' },
  { label: 'SHIPPED TARGETS', val: '3 WebGL Games · 1 Desktop Tool' },
  { label: 'FOCUS', val: 'Gameplay Systems, AI & Game Psychology' },
];

/** Experience cards open on the first sentence; the full entry expands (R4). */
const teaser = (text: string): string => /^(.+?\.)(\s|$)/.exec(text)?.[1] ?? text;
---

<Base>
  <header class="hero">
    <Prism />
    <div class="wrap grid">
      <div>
        <SignalStamp />
        <h1>
          <span class="kinetic-word" style="--word-idx:0">Junior</span>{' '}
          <span class="kinetic-word" style="--word-idx:1">Gameplay</span>{' '}
          <span class="kinetic-word" style="--word-idx:2">Programmer</span>
          <br />
          <em class="kinetic-word" style="--word-idx:3">(Unity / C#)</em>
        </h1>
        <p class="lead" data-reveal style="--reveal-delay:1">{site.tagline}</p>
        <div class="actions" data-reveal style="--reveal-delay:2">
          <a class="btn primary" href="#projects" data-track="hero-cta" data-track-meta="projects">▶ See the projects</a>
          <a class="btn" href="#lab" data-track="hero-cta" data-track-meta="lab">Play the mini-game</a>
          <a class="btn" href={site.cv} download data-track="download-cv" data-track-meta="hero">↓ Download the CV</a>
          <a class="btn" href={site.github} data-track="outbound-github" data-track-meta="hero">Open GitHub ↗</a>
        </div>
      </div>

      <div class="hero-stage" data-reveal style="--reveal-delay:2">
        <div class="note brutal-note" role="note" data-tilt data-tilt-max="3">
          "Read the board, set up the perfect turn." — the one-line pillar I wrote for my tactics game. It's also how
          I approach systems work.
          <small>field note</small>
        </div>
      </div>
    </div>

    <!-- Static CRT Hardware Readout Bar (replaces any moving slider below the title) -->
    <div class="wrap">
      <dl class="crt-spec-grid" aria-label="System and portfolio summary">
        {
          systemSpecs.map((s) => (
            <div class="crt-spec-cell">
              <dt>{s.label}</dt>
              <dd>{s.val}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <SignalLanding />
  </header>

  <!-- About as a dossier (R4): four facets, one open at a time; native <details> so it reads without JavaScript. -->
  <section id="about" class="section">
    <div class="wrap">
      <div class="section-head-bar" data-reveal>
        <div>
          <h2>About me</h2>
          <p class="sub-h">who · specialisation · interests · goals</p>
        </div>
        <span class="section-index-tag" aria-hidden="true">01</span>
      </div>
      <div class="dossier" data-reveal style="--reveal-delay:1">
        <details class="facet" name="about-facet" open>
          <summary>
            <span class="facet-code">01</span>
            <span class="facet-title">Who I am</span>
            <span class="facet-hint" aria-hidden="true"></span>
          </summary>
          <div class="facet-body">
            <p>
              I'm a BA Game Development student at Collegium Da Vinci in Poznań (2024 – present), specialising in gameplay
              programming in Unity 6 and C#. My projects include a survivors-like with a data-driven ability system,
              a deterministic grid-tactics game, and a 2D dungeon crawler I'm rebuilding
              from the ground up. Since July 2026 I've also been shipping Eternity Keeper, an open-source save editor for
              Pillars of Eternity — reverse-engineering a real RPG's save format and verifying every edit in the game.
            </p>
            <dl class="dl">
              <div><dt>Education</dt><dd>{education.title} ({education.period})</dd></div>
              <div><dt>Languages</dt><dd>Polish (native), English (C1)</dd></div>
            </dl>
          </div>
        </details>
        <details class="facet" name="about-facet">
          <summary>
            <span class="facet-code">02</span>
            <span class="facet-title">Specialisation</span>
            <span class="facet-hint" aria-hidden="true"></span>
          </summary>
          <div class="facet-body">
            <p>{site.title}.</p>
            <dl class="dl">
              <div><dt>Engine</dt><dd>Unity 6 (URP) · Unreal Engine 5 (Blueprints / C++)</dd></div>
              <div><dt>Language</dt><dd>C#</dd></div>
              <div><dt>Gameplay</dt><dd>AI &amp; NavMesh, ScriptableObject-driven design, Input System, Cinemachine, UI Toolkit</dd></div>
              <div><dt>Multiplayer</dt><dd>Netcode for GameObjects (architecture)</dd></div>
              <div><dt>Workflow</dt><dd>Git / GitHub (LFS, pull requests), Jira, Azure DevOps</dd></div>
              <div><dt>Also</dt><dd>DaVinci Resolve, Photoshop</dd></div>
            </dl>
          </div>
        </details>
        <details class="facet" name="about-facet">
          <summary>
            <span class="facet-code">03</span>
            <span class="facet-title">Interests</span>
            <span class="facet-hint" aria-hidden="true"></span>
          </summary>
          <div class="facet-body">
            <p>
              I care about the psychology of games — telegraphing, tension, the feeling of a "perfect turn". I explore
              that on my YouTube channel <a href={site.youtube}>phanto</a>, and it feeds back into how I design mechanics.
            </p>
            <dl class="dl">
              <div><dt>Interests</dt><dd>Gameplay systems &amp; AI, tactics / roguelite design, game psychology</dd></div>
            </dl>
          </div>
        </details>
        <details class="facet" name="about-facet">
          <summary>
            <span class="facet-code">04</span>
            <span class="facet-title">Goals</span>
            <span class="facet-hint" aria-hidden="true"></span>
          </summary>
          <div class="facet-body">
            <p>
              I'm looking to start out as a Junior Gameplay Programmer at a studio that makes systemic games—things like
              tactics, roguelites, RPGs or action titles where emergent systems, smart enemy behavior and reactive
              environments really drive the experience. Down the line, I'd love to grow into a systems and AI role where
              I'm not just coding those mechanics, but actively helping design them.
            </p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- Projects as a bento (R4): covers lift, and crossfade to a clip where one exists (R7). -->
  <section id="projects" class="section">
    <Prism small top="45%" />
    <div class="wrap">
      <div class="section-head-bar" data-reveal>
        <div>
          <h2>Projects</h2>
          <p class="sub-h">personal — games playable on itch.io, tools released on GitHub — each has its own write-up</p>
        </div>
        <span class="section-index-tag" aria-hidden="true">02</span>
      </div>
      <div class="bento" data-bento>
        {projects.map((p, i) => <ProjectTile project={p} index={i} span={spans[i] ?? 3} />)}
      </div>
    </div>
  </section>

  <TelegraphMiniGame />

  <section id="activities" class="section">
    <div class="wrap">
      <div class="section-head-bar" data-reveal>
        <div>
          <h2>Activities</h2>
          <p class="sub-h">team projects, channel, community</p>
        </div>
        <span class="section-index-tag" aria-hidden="true">04</span>
      </div>
      <div class="tl">
        {
          activities.map((a, idx) => (
            <article data-reveal data-tilt data-tilt-max="3" style={`--reveal-delay:${idx % 3}`}>
              <time>{a.period}</time>
              <h3 class="entry">{a.title}</h3>
              <p class="kind">{a.kind}</p>
              <p>{a.text}</p>
              {a.credits && <p class="credits">{a.credits}</p>}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Experience as expandable cards (R4): the first sentence shows, the full entry opens. -->
  <section id="experience" class="section">
    <div class="wrap">
      <div class="section-head-bar" data-reveal>
        <div>
          <h2>Experience</h2>
          <p class="sub-h">outside games — what transfers</p>
        </div>
        <span class="section-index-tag" aria-hidden="true">05</span>
      </div>
      <div class="two">
        <div data-reveal style="--reveal-delay:1">
          {
            experience.map((e) => (
              <details class="exp brutal-panel" data-tilt data-tilt-max="2.5">
                <summary>
                  <time class="meta">{e.period}</time>
                  <h3 class="entry">{e.title}</h3>
                  <p class="muted exp-teaser">{teaser(e.text)}</p>
                  <span class="exp-hint" aria-hidden="true"></span>
                </summary>
                <p class="muted exp-full">{e.text}</p>
              </details>
            ))
          }
        </div>
        <div class="note brutal-note" role="note" data-reveal style="--reveal-delay:2">
          I don't have game-industry employment yet. The projects above are where I've done my real gameplay work.
          <small>honest note</small>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact as a terminal card (R4) with a copy key for the address. -->
  <section id="contact" class="section">
    <div class="wrap">
      <div class="section-head-bar" data-reveal>
        <div>
          <h2>Contact</h2>
          <p class="sub-h">email · github · youtube · cv</p>
        </div>
        <span class="section-index-tag" aria-hidden="true">06</span>
      </div>
      <div class="two">
        <div class="tty crt-frame" data-reveal data-tilt data-tilt-max="2" style="--reveal-delay:1">
          <div class="crt-win-bar" aria-hidden="true">
            <span>[■] CONTACT // TTY_01</span>
            <span class="win-status">● ONLINE</span>
          </div>
          <dl class="tty-lines">
            <div>
              <dt><span aria-hidden="true">$ </span>mail</dt>
              <dd>
                <a href={`mailto:${site.email}`}>{site.email}</a>
                <button type="button" class="key tty-copy" data-copy={site.email} aria-label="Copy the e-mail address">copy</button>
              </dd>
            </div>
            <div>
              <dt><span aria-hidden="true">$ </span>github</dt>
              <dd><a href={site.github}>github.com/{site.githubHandle}</a></dd>
            </div>
            <div>
              <dt><span aria-hidden="true">$ </span>youtube</dt>
              <dd><a href={site.youtube}>{site.youtubeHandle}</a></dd>
            </div>
            <div>
              <dt><span aria-hidden="true">$ </span>cv</dt>
              <dd><a href={site.cv} download>CV_Tymoteusz_Jaskolski_EN.pdf</a></dd>
            </div>
          </dl>
          <p class="tty-prompt" aria-hidden="true"><span aria-hidden="true">&gt;</span> <span class="tty-caret"></span></p>
        </div>
        <div class="cta brutal-panel" data-reveal data-tilt data-tilt-max="3" style="--reveal-delay:2">
          <p class="lead">Looking for a junior gameplay programmer or an intern? I'd love to talk.</p>
          <a class="btn primary" href={`mailto:${site.email}`} data-track="contact-email" data-track-meta="cta">
            ✉ Write to me
          </a>
        </div>
      </div>
    </div>
  </section>

  <script>
    import { prefs } from '../scripts/prefs';

    const isMotionAllowed = () => prefs.isMotionAllowed();

    document.addEventListener('astro:page-load', () => {
      armStuckHead();
      bindTiles();
      bindCopyKeys();
    });

    // Projects head bar: CSS makes it sticky on wide screens; this only marks when it is being held
    // under the nav (.is-stuck adds the frosted background). Paint only, so no layout shift.
    function armStuckHead() {
      const bar = document.querySelector<HTMLElement>('#projects .section-head-bar');
      if (!bar) return;
      const page = new AbortController();
      let queued = false;
      const update = () => {
        queued = false;
        const sticky = getComputedStyle(bar).position === 'sticky';
        const top = bar.getBoundingClientRect().top;
        const offset = parseFloat(getComputedStyle(bar).top) || 0;
        bar.classList.toggle('is-stuck', sticky && window.scrollY > 0 && Math.abs(top - offset) < 1);
      };
      const queue = () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(update);
      };
      window.addEventListener('scroll', queue, { passive: true, signal: page.signal });
      window.addEventListener('resize', queue, { passive: true, signal: page.signal });
      document.addEventListener('astro:before-swap', () => page.abort(), { once: true, signal: page.signal });
      update();
    }

    // Bento tiles: a tile with a clip plays it on hover or focus (muted, looping) and shows the still again
    // on leave; nothing plays under reduced motion or on touch (no hover there), so the still stays.
    function bindTiles() {
      document.querySelectorAll<HTMLElement>('[data-tile]').forEach((tile) => {
        const clip = tile.querySelector<HTMLVideoElement>('[data-tile-clip]');
        if (!clip) return;
        const play = (e: Event) => {
          if (!isMotionAllowed() || (e as PointerEvent).pointerType === 'touch') return;
          tile.classList.add('is-playing');
          void clip.play().catch(() => tile.classList.remove('is-playing'));
        };
        const stop = () => {
          tile.classList.remove('is-playing');
          clip.pause();
          clip.currentTime = 0;
        };
        tile.addEventListener('pointerenter', play);
        tile.addEventListener('pointerleave', stop);
        tile.addEventListener('focusin', play);
        tile.addEventListener('focusout', (e) => {
          if (!tile.contains(e.relatedTarget as Node | null)) stop();
        });
      });
    }

    // The contact terminal's copy key.
    function bindCopyKeys() {
      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((key) => {
        key.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(key.dataset.copy ?? '');
            key.textContent = 'copied ✓';
          } catch {
            key.textContent = 'failed';
          }
          window.setTimeout(() => (key.textContent = 'copy'), 1600);
        });
      });
    }
  </script>
</Base>

<style>
  .hero {
    position: relative;
    padding: 96px 0 72px;
    overflow: hidden;
  }
  .hero .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.85fr);
    gap: 44px;
    align-items: center;
  }
  h1 {
    margin: 18px 0 20px;
  }
  h1 em {
    font-style: italic;
    font-weight: 400;
    color: var(--peach);
  }
  .lead {
    margin-bottom: 32px;
  }
  .actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .note {
    font-family: var(--display);
    font-style: italic;
    font-size: 16px;
    color: var(--lavender);
    border-left: 2px solid var(--coral);
    padding-left: 16px;
    line-height: 1.5;
    font-variation-settings: 'SOFT' 60;
  }
  .note small {
    display: block;
    font-family: var(--mono);
    font-style: normal;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--coral);
    margin-top: 10px;
  }
  .brutal-note {
    background: var(--surface);
    border: 1.5px solid var(--umber);
    border-left: 4px solid var(--coral);
    border-radius: var(--r-sm);
    padding: 20px;
    box-shadow: var(--card-depth);
    align-self: start;
  }
  .brutal-panel {
    background: var(--surface);
    border: 1.5px solid var(--umber);
    border-radius: var(--r-md);
    padding: 22px;
    box-shadow: var(--card-depth);
  }

  /* ---- About: the dossier ---- */
  .dossier {
    max-width: 760px;
    border-top: 1px solid var(--umber);
  }
  .facet {
    border-bottom: 1px solid var(--umber);
  }
  .facet summary {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 16px;
    padding: 18px 8px;
    margin: 0 -8px;
    cursor: pointer;
    list-style: none;
    border-radius: var(--r-xs);
    transition: background 0.2s ease;
  }
  .facet summary::-webkit-details-marker {
    display: none;
  }
  .facet summary:hover {
    background: color-mix(in srgb, var(--surface) 70%, transparent);
  }
  .facet summary:focus-visible {
    outline: 2px solid var(--coral);
    outline-offset: 2px;
  }
  .facet-code {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    color: var(--gold);
  }
  .facet-title {
    font-family: var(--display);
    font-size: 26px;
    font-weight: 600;
    line-height: 1.1;
    color: var(--text);
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
    transform-origin: left center;
    transition:
      transform 0.3s var(--ease-out-expo),
      letter-spacing 0.3s ease,
      color 0.3s ease,
      font-variation-settings 0.3s ease;
  }
  /* Owner rule: hovered titles grow, never tighten. */
  .facet summary:hover .facet-title {
    color: var(--peach);
    letter-spacing: 0.02em;
    transform: scale(1.02);
    font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 9;
  }
  .facet[open] .facet-title {
    color: var(--peach);
  }
  .facet-hint::before {
    content: '[ + ]';
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--coral);
  }
  .facet[open] .facet-hint::before {
    content: '[ − ]';
  }
  .facet-body {
    padding: 0 0 22px 60px;
  }
  :global(html.js-motion) .facet[open] .facet-body {
    animation: facet-in 320ms var(--ease-out-expo) both;
  }
  @keyframes facet-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  .facet-body p {
    margin-bottom: 14px;
  }
  .facet-body .dl {
    border-top: 0;
    font-size: 14px;
  }

  /* ---- Projects: the bento ---- */
  .bento {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 20px;
  }
  /* Hovering one tile dims the others (the R8 mecha pattern); back to full on leave. */
  .bento:has(:global(.tile:hover)) :global(.tile:not(:hover)) {
    opacity: 0.74;
  }

  /* ---- Activities ---- */
  .tl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 32px;
  }
  .tl article {
    padding: 20px 22px 20px 26px;
    background: var(--surface);
    border: 1px solid var(--umber);
    border-left: 3px solid var(--coral);
    border-radius: var(--r-sm);
    box-shadow: var(--card-depth);
    position: relative;
  }
  .tl article:hover {
    border-color: var(--peach);
    box-shadow: var(--card-depth-hover);
  }
  .tl article::before {
    content: '';
    position: absolute;
    left: -6px;
    top: 24px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--coral);
    box-shadow: 0 0 10px var(--coral);
  }
  .tl time {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--gold);
    letter-spacing: 0.06em;
  }
  .tl h3 {
    margin: 6px 0 2px;
  }
  .tl .kind {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--steel);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .tl p {
    color: var(--text-2);
    font-size: 15px;
    margin: 0;
  }
  .tl .credits {
    font-size: 13px;
    color: var(--text-3);
    margin-top: 8px;
  }

  /* ---- Experience: expandable cards ---- */
  .exp summary {
    cursor: pointer;
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 4px 16px;
  }
  .exp summary::-webkit-details-marker {
    display: none;
  }
  .exp summary:focus-visible {
    outline: 2px solid var(--coral);
    outline-offset: 6px;
    border-radius: var(--r-xs);
  }
  .exp summary time {
    grid-column: 1;
  }
  .exp h3 {
    margin: 6px 0;
    grid-column: 1;
  }
  .exp-teaser {
    grid-column: 1;
    margin: 0;
  }
  .exp-hint {
    grid-column: 2;
    grid-row: 1 / span 3;
    align-self: start;
  }
  .exp-hint::before {
    content: '[ + READ ]';
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--coral);
    white-space: nowrap;
  }
  .exp[open] .exp-hint::before {
    content: '[ − CLOSE ]';
  }
  .exp[open] .exp-teaser {
    display: none;
  }
  .exp-full {
    margin: 4px 0 0;
    padding-top: 12px;
    border-top: var(--line);
  }
  :global(html.js-motion) .exp[open] .exp-full {
    animation: facet-in 320ms var(--ease-out-expo) both;
  }
  .cta {
    align-self: center;
  }

  /* ---- Contact: the terminal ---- */
  .tty {
    background: var(--surface);
    border: 1.5px solid var(--umber);
    border-radius: var(--r-md);
    overflow: hidden;
    align-self: start;
  }
  .tty .crt-win-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 18px;
    background: var(--surface-2);
    border-bottom: 1px solid var(--umber);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--steel);
  }
  .tty .win-status {
    color: var(--mint);
  }
  .tty-lines {
    margin: 0;
    padding: 14px 18px 4px;
    font-family: var(--mono);
    font-size: 14px;
  }
  .tty-lines > div {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 12px;
    padding: 8px 0;
    align-items: center;
  }
  .tty-lines dt {
    color: var(--gold);
    letter-spacing: 0.04em;
    margin: 0;
  }
  .tty-lines dd {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    overflow-wrap: anywhere;
  }
  .tty-lines a {
    color: var(--text);
  }
  .tty-lines a:hover {

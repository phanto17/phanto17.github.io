---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Prism from '../../components/Prism.astro';
import Figure from '../../components/Figure.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const hero = d.media[0];
const gallery = d.media.slice(1);
const period = `${d.dates.start}${d.dates.end ? ` – ${d.dates.end}` : ' – now'}`;
---

<Base title={d.title} description={d.summary} image={`/media/og/${project.id}.jpg`}>
  <header class="phero">
    <Prism top="-120px" />
    <div class="wrap">
      <p class="kicker"><a href="/#projects">← Projects</a> · {d.genre}</p>
      <h1>{d.title}</h1>
      <p class="lead">{d.summary}</p>
      <p class="meta">{d.engine} · {d.role} · {period}</p>
      <div class="actions">
        {
          d.kind === 'tool' ? (
            d.downloadUrl ? (
              <a class="btn primary" href={d.downloadUrl}>↓ Download (Windows)</a>
            ) : (
              <span class="btn" aria-disabled="true">↓ Download — not released yet</span>
            )
          ) : d.itchUrl ? (
            <a class="btn primary" href={d.itchUrl}>▶ Play on itch.io</a>
          ) : (
            <span class="btn" aria-disabled="true">▶ Not on itch.io yet</span>
          )
        }
        {d.githubUrl && <a class="btn" href={d.githubUrl}>Source on GitHub</a>}
      </div>
    </div>
  </header>

  <div class="wrap layout">
    <article class="prose">
      <Figure type={hero?.type} src={hero?.src} alt={hero?.alt ?? `${d.title} gameplay`} caption={hero?.caption ?? `Fig. 1 — ${d.title}, gameplay`} priority />

      <section>
        <h2>What I built</h2>
        <p class="sub-h">my contribution — nothing here is third-party work</p>
        <ul>
          {d.myContribution.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="content">
        <Content />
      </section>

      {
        gallery.length > 0 && (
          <section>
            <h2>Gallery</h2>
            <div class="gallery">
              {gallery.map((m, i) => (
                <Figure type={m.type} src={m.src} alt={m.alt} caption={m.caption ?? `Fig. ${i + 2}`} />
              ))}
            </div>
          </section>
        )
      }

      <section>
        <h2>Credits</h2>
        <p class="sub-h">third-party assets used — with thanks</p>
        {
          d.credits.length > 0 ? (
            <table>
              <thead>
                <tr><th>Asset</th><th>Author</th><th>Licence</th></tr>
              </thead>
              <tbody>
                {d.credits.map((c) => (
                  <tr>
                    <td>{c.url ? <a href={c.url}>{c.asset}</a> : c.asset}</td>
                    <td>{c.author}</td>
                    <td>{c.license ?? <span class="muted">—</span>}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          ) : (
            <p class="muted">No third-party assets.</p>
          )
        }
      </section>
    </article>

    <aside class="side">
      <div class="box">
        <dl>
          <dt>Status</dt>
          <dd>{{ playable: 'Playable', released: 'Released', 'in-progress': 'Build in progress', planned: 'Rework planned' }[d.status]}</dd>
          <dt>{d.kind === 'tool' ? 'Download' : 'Play'}</dt>
          <dd>
            {
              d.kind === 'tool' ? (
                d.downloadUrl ? <a href={d.downloadUrl}>GitHub Releases ↗</a> : <span class="muted">Not released yet</span>
              ) : d.itchUrl ? (
                <a href={d.itchUrl}>itch.io ↗</a>
              ) : (
                <span class="muted">Not published yet</span>
              )
            }
          </dd>
          <dt>Source</dt>
          <dd>{d.githubUrl ? <a href={d.githubUrl}>GitHub ↗</a> : <span class="muted">Private repository</span>}</dd>
          <dt>Role</dt>
          <dd>{d.role}</dd>
          <dt>Period</dt>
          <dd>{period}</dd>
          <dt>Tools</dt>
          <dd>{d.tools.join(', ')}</dd>
        </dl>
      </div>
    </aside>
  </div>
</Base>

<style>
  .phero {
    position: relative;
    padding: 96px 0 48px;
    overflow: hidden;
  }
  .phero h1 {
    font-size: clamp(40px, 6vw, 68px);
    margin: 12px 0 16px;
  }
  .phero .lead {
    margin-bottom: 12px;
  }
  .actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 24px;
  }
  .phero .kicker a {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .phero .kicker a:hover {
    color: var(--peach);
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 40px;
    padding-top: 24px;
    padding-bottom: 80px;
  }
  .prose section {
    margin-top: 56px;
  }
  .prose h2 {
    font-size: 30px;
  }
  .content :global(h2) {
    font-size: 30px;
    margin-top: 56px;
  }
  .content :global(h3) {
    font-size: 23px;
    margin-top: 32px;
  }
  .content :global(p),
  .content :global(li) {
    color: var(--text);
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .side {
    position: sticky;
    top: 88px;
    align-self: start;
    font-size: 14px;
  }
  .box {
    background: var(--surface);
    border: 1px solid var(--umber);
    border-radius: var(--r-md);
    padding: 16px;
  }
  .box dl {
    margin: 0;
  }
  .box dt {
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--steel);
    margin-top: 12px;
  }
  .box dt:first-child {
    margin-top: 0;
  }
  .box dd {
    margin: 3px 0 0;
  }
  @media (max-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .side {
      position: static;
    }
  }
  @media (max-width: 860px) {
    .phero {
      padding: 64px 0 32px;
    }
    .gallery {
      grid-template-columns: minmax(0, 1fr);
    }
    .side {
      position: static;
    }
  }
</style>

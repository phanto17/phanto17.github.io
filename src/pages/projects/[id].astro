---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionStrip from '../../components/SectionStrip.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Figure from '../../components/Figure.astro';
import NotesExplorer from '../../components/NotesExplorer.astro';
import ShoveLab from '../../components/ShoveLab.astro';
import { PERSON_ID, PROJECTS_INDEX, site } from '../../data/site';
import { planWriteUp } from '../../lib/notes';
import { projectView } from '../../lib/project-view';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort(
    (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99) || a.id.localeCompare(b.id),
  );
  return projects.map((project) => ({ params: { id: project.id }, props: { project, allProjects: projects } }));
}

const { project, allProjects } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const plan = project.rendered?.html
  ? planWriteUp({ html: project.rendered.html, media: d.media, widget: d.widget })
  : null;
const hero = d.media[0];
const gallery = d.media.slice(1);
const featuredShot = gallery[0];
const restShots = gallery.slice(1);
const view = projectView(d);
const period = view.period;
const siblings = allProjects.filter((p) => p.id !== project.id).slice(0, 3);

const isGame = d.kind === 'game';
const pageUrl = `${site.url}${PROJECTS_INDEX}${project.id}/`;
const abs = (path: string) => new URL(path, site.url).toString();

const appNode: Record<string, unknown> = {
  '@type': isGame ? 'VideoGame' : 'SoftwareApplication',
  '@id': `${pageUrl}#app`,
  name: d.title,
  description: d.summary,
  genre: d.genre,
  url: pageUrl,
  image: abs(`/media/og/${project.id}.jpg`),
  screenshot: d.media.filter((m) => m.type === 'image').map((m) => abs(m.src)),
  dateCreated: d.dates.start,
  author: { '@id': PERSON_ID },
  applicationCategory: isGame
    ? 'GameApplication'
    : d.kind === 'engine'
      ? 'DeveloperApplication'
      : 'UtilitiesApplication',
  operatingSystem: isGame ? (d.itchUrl ? 'Web browser (WebGL)' : 'Windows (.NET 10)') : 'Windows',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: d.itchUrl ?? d.downloadUrl ?? d.githubUrl ?? pageUrl,
  },
  sameAs: [d.itchUrl, d.githubUrl, d.downloadUrl].filter(Boolean),
  ...(d.basedOn ? { isBasedOn: d.basedOn } : {}),
  ...(isGame
    ? {
        gamePlatform: d.itchUrl ? 'Web browser' : 'PC',
        playMode: 'SinglePlayer',
        ...(d.itchUrl ? { installUrl: d.itchUrl } : {}),
      }
    : { license: d.kind === 'tool' ? 'https://www.gnu.org/licenses/gpl-3.0.html' : undefined }),
};

const projectSchema = [
  {
    '@type': 'WebPage',
    '@id': pageUrl,
    url: pageUrl,
    name: `${d.title} — ${site.name}`,
    description: d.summary,
    isPartOf: { '@id': `${site.url}/#website` },
    about: { '@id': `${pageUrl}#app` },
    primaryImageOfPage: abs(`/media/og/${project.id}.jpg`),
    breadcrumb: {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
        { '@type': 'ListItem', position: 2, name: 'Projects', item: `${site.url}${PROJECTS_INDEX}` },
        { '@type': 'ListItem', position: 3, name: d.title, item: pageUrl },
      ],
    },
  },
  appNode,
];

const railSections = [
  { id: 'hero', label: 'Top' },
  { id: 'highlights', label: '01 Highlights' },
  { id: 'contribution', label: '02 Contribution' },
  ...(gallery.length > 0 ? [{ id: 'screenshots', label: '03 Gallery' }] : []),
  { id: 'breakdown', label: '04 Breakdown' },
  { id: 'get-it', label: '05 Credits' },
  { id: 'lineup', label: '06 Lineup' },
] as const;

const hasSeparateGithub = Boolean(d.githubUrl && d.githubUrl !== view.live?.href);
---

<Base
  title={d.title}
  description={d.summary}
  image={`/media/og/${project.id}.jpg`}
  schema={projectSchema}
  accent={d.world.accent}
  sections={railSections}
>
  <div class="rail-frame">
    <header class="ac-sub-hero" id="hero">
      <nav class="ac-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href={PROJECTS_INDEX}>Projects</a>
        <span aria-hidden="true">/</span>
        <span>{d.title}</span>
      </nav>

      <div class="ac-tag-row">
        <span class:list={['pill', view.live ? 'play' : 'wip']}>{view.status}</span>
        {d.category && <span class="ac-mini-pill">{d.category}</span>}
        <span class="ac-mini-pill">{period}</span>
        <span class="ac-mini-pill">{d.engine}</span>
      </div>

      <h1>
        <span transition:name={`title-${project.id}`}>{d.title}</span>
      </h1>
      <p class="ac-sub-lead">{d.summary}</p>

      {
        d.metrics.length > 0 && (
          <ul class="stat-chips" aria-label="Verified engineering metrics">
            {d.metrics.map((m) => (
              <li class="stat-chip">{m}</li>
            ))}
          </ul>
        )
      }

      <div class="ac-cta-row" style="justify-content:flex-start;margin-top:20px">
        {
          view.live ? (
            <a class="btn primary" href={view.live.href} target="_blank" rel="noopener">
              {view.live.label}
              {d.kind === 'tool' && ' (Windows)'}
            </a>
          ) : (
            <span class="btn" aria-disabled="true">
              {view.pending}
            </span>
          )
        }
        {
          hasSeparateGithub && (
            <a class="btn" href={d.githubUrl} target="_blank" rel="noopener">
              Source on GitHub ↗
            </a>
          )
        }
        <a class="btn" href="#breakdown">Technical Breakdown ↓</a>
      </div>
    </header>

    <div class="ac-hero-stage">
      <div data-tilt data-tilt-max="2.5" transition:name={`cover-${project.id}`}>
        <Figure
          type={hero?.type}
          src={hero?.src}
          alt={hero?.alt ?? `${d.title} preview`}
          caption={hero?.caption ?? `Fig. 1 — ${d.title}`}
          priority
        />
      </div>
      <div class="ac-stage-bar">
        <span class="muted">Role: <strong>{d.role}</strong></span>
        <button type="button" id="crt-toggle" class="key hud-key crt-key" aria-pressed="true">
          CRT Scanlines: ON
        </button>
      </div>
    </div>

    {
      d.highlights.length > 0 && (
        <section id="highlights">
          <SectionStrip
            num="01"
            title="Key Architecture & Highlights"
            meta={`${d.highlights.length} VERIFIED CAPABILITIES`}
          />
          <div class="hairline-grid-3">
            {d.highlights.map((item, idx) => (
              <article class="ac-cell" data-reveal>
                <p class="ac-cell-label">{String(idx + 1).padStart(2, '0')} // SYSTEM</p>
                <p>{item}</p>
              </article>
            ))}
          </div>
        </section>
      )
    }

    <section id="contribution">
      <SectionStrip num="02" title="My Contribution & Tools" meta={d.engine} />
      <div class="hairline-split">
        <div class="ac-panel-pad">
          <h3>What I designed, built &amp; verified</h3>
          <ul class="diamond-list">
            {d.myContribution.map((item) => <li>{item}</li>)}
          </ul>

          {
            d.changelog.length > 0 && (
              <details class="changelog hud-panel">
                <summary>Iteration &amp; playtest history ({d.changelog.length} updates)</summary>
                <ul>
                  {d.changelog.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </details>
            )
          }
        </div>

        <div class="ac-panel-pad">
          <h3>Specifications &amp; Stack</h3>
          <dl class="dl">
            <div>
              <dt>Role</dt>
              <dd>{d.role}</dd>
            </div>
            <div>
              <dt>Timeline</dt>
              <dd>{period}</dd>
            </div>
            <div>
              <dt>Engine / Stack</dt>
              <dd>{d.engine}</dd>
            </div>
            {
              d.platforms.length > 0 && (
                <div>
                  <dt>Targets</dt>
                  <dd>{d.platforms.join(' · ')}</dd>
                </div>
              )
            }
          </dl>

          <p class="ac-cell-label" style="margin-top:20px">TOOLS &amp; PACKAGES</p>
          <div class="ac-tag-row">
            {d.tools.map((t) => <span class="ac-mini-pill">{t}</span>)}
          </div>
        </div>
      </div>
    </section>

    {
      gallery.length > 0 && (
        <section id="screenshots">
          <SectionStrip
            num="03"
            title="Visuals & Gameplay Captures"
            meta={`${gallery.length} ADDITIONAL FRAMES`}
          />
          <div class="screenshots-1plus2">
            {featuredShot && (
              <div class="screenshots-featured">
                <Figure
                  type={featuredShot.type}
                  src={featuredShot.src}
                  alt={featuredShot.alt}
                  caption={featuredShot.caption ?? `Fig. 2 — ${d.title}`}
                />
              </div>
            )}
            {restShots.length > 0 && (
              <div
                class={
                  restShots.length === 3
                    ? 'hairline-grid-3'
                    : restShots.length === 1
                      ? 'hairline-grid-1'
                      : 'hairline-grid-2'
                }
              >
                {restShots.map((m, idx) => (
                  <div class="ac-cell">
                    <Figure
                      type={m.type}
                      src={m.src}
                      alt={m.alt}
                      caption={m.caption ?? `Fig. ${idx + 3}`}
                    />
                  </div>
                ))}
              </div>
            )}
          </div>
        </section>
      )
    }

    <section id="breakdown">
      <SectionStrip
        num="04"
        title="Technical Breakdown"
        meta={d.widget === 'shove-lab' ? 'NOTES + INTERACTIVE SHOVE SANDBOX' : 'CODE · DIAGRAMS · DESIGN'}
      />
      <div class="ac-breakdown-pad prose">
        {plan ? <Fragment set:html={plan.before + plan.intro} /> : <Content />}
      </div>
      {
        plan && (
          <div class="ac-breakdown-pad">
            <NotesExplorer plan={plan} title={d.title}>
              <Fragment slot="widget">{d.widget === 'shove-lab' && <ShoveLab />}</Fragment>
            </NotesExplorer>
          </div>
        )
      }
    </section>

    <section id="get-it">
      <SectionStrip num="05" title="Play, Source & Third-Party Credits" meta="FULL ATTRIBUTION" />
      <div class="hairline-split">
        <div class="ac-panel-pad">
          <h3>Links &amp; Distribution</h3>
          <p>
            {d.itchUrl
              ? 'This project runs directly in the browser on itch.io as a free WebGL release.'
              : isGame
                ? 'Source code, test suites and playable desktop/CLI instructions are available on GitHub.'
                : 'Source repositories, automated test suites and releases are public on GitHub.'}
          </p>
          <div class="ac-cta-row" style="justify-content:flex-start;margin-top:16px">
            {
              view.live && (
                <a class="btn primary" href={view.live.href} target="_blank" rel="noopener">
                  {view.live.label}
                </a>
              )
            }
            {
              hasSeparateGithub && (
                <a class="btn" href={d.githubUrl} target="_blank" rel="noopener">
                  Repository ↗
                </a>
              )
            }
            {
              d.basedOn && (
                <a class="btn" href={d.basedOn} target="_blank" rel="noopener">
                  Upstream Fork ↗
                </a>
              )
            }
          </div>
        </div>

        <div class="ac-panel-pad">
          <h3>Third-Party &amp; Asset Credits</h3>
          {
            d.credits.length > 0 ? (
              <div class="table-wrap hud-panel" role="region" aria-label="Third-party asset credits" tabindex="0">
                <table>
                  <thead>
                    <tr>
                      <th>Asset</th>
                      <th>Author</th>
                      <th>Licence</th>
                    </tr>
                  </thead>
                  <tbody>
                    {d.credits.map((c) => (
                      <tr>
                        <td>
                          {c.url ? (
                            <a href={c.url} target="_blank" rel="noopener">
                              {c.asset}
                            </a>
                          ) : (
                            c.asset
                          )}
                        </td>
                        <td>{c.author}</td>
                        <td>{c.license ?? 'See source'}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ) : (
              <p class="muted">No external assets used.</p>
            )
          }
        </div>
      </div>
    </section>

    <section id="lineup">
      <SectionStrip num="06" title="More Projects" meta="CONTINUE EXPLORING" />
      <div class="hairline-grid-3">
        {
          siblings.map((p) => (
            <ProjectCard project={p} index={allProjects.findIndex((x) => x.id === p.id)} />
          ))
        }
      </div>
    </section>
  </div>
</Base>

<script>
  import { onPage } from '../../scripts/page';
  import { prefs } from '../../scripts/prefs';

  onPage(({ signal }) => {
    document.querySelectorAll<HTMLPreElement>('pre.astro-code').forEach((pre) => {
      if (pre.parentElement?.classList.contains('code-block-wrap')) return;
      const wrap = document.createElement('div');
      wrap.className = 'code-block-wrap';
      pre.replaceWith(wrap);
      wrap.appendChild(pre);

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'key copy-code-btn';
      btn.textContent = 'Copy';
      btn.setAttribute('aria-label', 'Copy code snippet to clipboard');
      wrap.appendChild(btn);

      btn.addEventListener(
        'click',
        async () => {
          const code = pre.querySelector('code')?.textContent ?? '';
          try {
            await navigator.clipboard.writeText(code);
            btn.textContent = 'Copied ✓';
          } catch {
            btn.textContent = 'Failed';
          }
          setTimeout(() => {
            btn.textContent = 'Copy';
          }, 1600);
        },
        { signal },
      );
    });

    const crtBtn = document.querySelector<HTMLButtonElement>('#crt-toggle');
    if (crtBtn) {
      const syncCrt = () => {
        const on = prefs.get('crt') === 'on';
        crtBtn.setAttribute('aria-pressed', String(on));
        crtBtn.textContent = on ? 'CRT Scanlines: ON' : 'CRT Scanlines: OFF';
      };
      syncCrt();
      crtBtn.addEventListener(
        'click',
        () => {
          prefs.set('crt', prefs.get('crt') === 'on' ? 'off' : 'on');
          syncCrt();
        },
        { signal },
      );
    }
  });
</script>

---
import Base from '../layouts/Base.astro';
import { PROJECTS_INDEX, site } from '../data/site';
---

<Base title="404 — Page not found" description="Page not found on Tymoteusz Jaskólski's portfolio." noindex>
  <div class="rail-frame">
    <section class="ac-hero">
      <p class="ac-hero-kicker">HTTP 404 // UNKNOWN ROUTE</p>
      <h1>Page not found</h1>
      <p class="ac-hero-lead">
        Nothing lives at this URL on {site.name}&rsquo;s portfolio. Jump back to the main showcase or inspect all six projects directly.
      </p>
      <div class="ac-cta-row">
        <a class="btn primary" href="/">← Back to Home</a>
        <a class="btn" href={PROJECTS_INDEX}>Browse All Projects →</a>
      </div>
    </section>
  </div>
</Base>

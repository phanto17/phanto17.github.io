---
/**
 * Living style guide, generated from design/tokens.json (the Prism CRT design system's token file).
 * Colour swatches, contrast ratios, the type scale and the spacing/radius tables are read from the
 * file at build time, so this page cannot drift from src/styles/tokens.css.
 */
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';
import { getCollection } from 'astro:content';
import tokens from '../../design/tokens.json';
import { accentContrast, accentInks, accentTheme, contrast, ACCENT_MINIMUM, type AccentTokens } from '../lib/accents';
import { UNCHARTED_ACCENT } from '../lib/accents';
import { buildLocations } from '../data/locations';
import { projectView } from '../lib/project-view';

type ThemeId = 'prism' | 'paper' | 'crt' | 'signal';
const themes = tokens.color.themes as { id: ThemeId; name: string }[];
const colourTokens = tokens.color.tokens as { name: string; value: string | Record<string, string>; usage: string }[];

const valueFor = (t: { value: string | Record<string, string> }, theme: ThemeId): string =>
  typeof t.value === 'string' ? t.value : (t.value[theme] ?? t.value[themes[0].id]);
const resolve = (name: string, theme: ThemeId): string => {
  const t = colourTokens.find((c) => c.name === name);
  if (!t) return '#000000';
  const v = valueFor(t, theme);
  return /^\{[^}]+\}$/.test(v) ? resolve(v.slice(1, -1), theme) : v;
};

/** Every accent the map draws, toned per theme as the field kit does (contrast and mixes: src/lib/accents.ts). */
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const projectAccents = projects.map((p) => ({ name: p.data.title, accent: p.data.world.accent }));
const accentRows = [
  ...colourTokens.filter((t) => t.name.startsWith('loc-')).map((t) => ({ name: t.name, accent: t.value as string })),
  ...projectAccents,
  { name: 'Uncharted (free slot)', accent: UNCHARTED_ACCENT },
];
const accentRules = (tokens as unknown as AccentTokens).accent.tokens;
const accentRow = (accent: string, theme: ThemeId) => {
  const rules = accentTheme(tokens as unknown as AccentTokens, theme);
  const c = accentContrast(accent, rules);
  return { inks: accentInks(accent, rules), ...c, ok: c.eyebrow >= ACCENT_MINIMUM.eyebrow && c.edge >= ACCENT_MINIMUM.edge };
};

const grounds = ['bg', 'surface', 'surface-2'];
const inks = ['text', 'text-2', 'text-3', 'steel', 'action-text', 'coral', 'peach', 'gold', 'mint', 'lavender', 'brick'];
const decorative = ['bg-0', 'umber', 'hairline', 'nav-bg', 'scanline', 'teal', 'pink', 'sky', 'backdrop', 'glow-ink', 'panel', 'ink-black', 'world-ground', 'ai-wander', 'ai-alert', 'ai-flee', 'pass'];
const bands = colourTokens.filter((t) => t.name.startsWith('prism-'));
const cells = colourTokens.filter((t) => t.name.startsWith('cell-'));

const typeGroups = tokens.type.groups as {
  name: string;
  family: string;
  note?: string;
  styles: { name: string; fontSize: string; lineHeight?: number | string; fontWeight?: number; letterSpacing?: string; fontStyle?: string; sample?: string; usage: string }[];
}[];
const families = tokens.type.families as Record<string, string>;
/** The field kit's specimens (P6) show a real place: the first project, as its label and its drawer. */
const locations = buildLocations(projects);
const sample = projects[0];
const sampleView = projectView(sample.data);
const sampleEyebrow = `01 · ${sample.data.genre}`;
/** The field log as the index lists it, with the first two places marked explored for the specimen. */
const logPlaces = locations.slice(0, 8);
/** Every place's eyebrow, by name, and the free slot. */
const eyebrowPlaces = [...locations.map((l) => ({ name: l.title, accent: l.accent })), { name: 'Uncharted', accent: UNCHARTED_ACCENT }];
const views = ['Beauty', 'Wire', 'Normals', 'Clay', 'Depth'];

const simple = (fam: 'spacing' | 'radius' | 'timing' | 'easing') => (tokens[fam] as { tokens: { name: string; value: string; usage: string }[] }).tokens;
---

<Base
  noindex
  title="Style Guide — Prism CRT"
  description="Living design system and component reference for Tymoteusz Jaskólski's game-dev portfolio, generated from the token file."
>
  <header class="sg-hero">
    <div class="wrap">
      <p class="kicker">Living Design Document</p>
      <h1>Prism <em>CRT</em></h1>
      <p class="lead">
        Warm darkroom grain, Cooper/Windsor-inspired variable serif display type, tactile 80s/90s CRT viewport frames,
        and accessible theme and motion controls. Four themes (Signal is unlocked by clearing Telegraph Recall), one token file.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="wrap">
      <h2>01 · Colour &amp; contrast</h2>
      <p class="sub-h">every ink on every ground, per theme · WCAG 2 ratios computed at build time</p>
      {
        themes.map((theme) => (
          <div class="theme-block" data-theme={theme.id}>
            <h3>{theme.name}</h3>
            <div class="table-wrap" role="region" aria-label={`${theme.name} tokens`} tabindex="0">
              <table>
                <thead>
                  <tr>
                    <th>Ink</th>
                    <th>Value</th>
                    {grounds.map((g) => (
                      <th>on {g}</th>
                    ))}
                    <th>Use</th>
                  </tr>
                </thead>
                <tbody>
                  {inks.map((name) => {
                    const t = colourTokens.find((c) => c.name === name)!;
                    const ink = resolve(name, theme.id);
                    return (
                      <tr>
                        <td>
                          <span class="chip" style={`background:${ink}`} /> <code>{name}</code>
                        </td>
                        <td class="hex">{ink}</td>
                        {grounds.map((g) => {
                          const ratio = contrast(ink, resolve(g, theme.id));
                          const large = name === 'brick';
                          const ok = ratio >= (large ? 3 : 4.5);
                          return <td class={ok ? 'ok' : 'warn'}>{ratio}:1{large ? ' (large)' : ''}</td>;
                        })}
                        <td class="use">{t.usage}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </div>
        ))
      }
      <h3 style="margin-top:36px">Decoration, bands and board fills</h3>
      <p class="muted">Never text. The usage note on each says where it may appear.</p>
      <div class="swatches">
        {
          [...decorative.map((n) => colourTokens.find((c) => c.name === n)!), ...bands, ...cells].map((t) => (
            <div class="swatch-card">
              <div class="swatch-chip" style={`background:${resolve(t.name, 'prism')}`} />
              <div class="swatch-meta">
                <code>{t.name}</code>
                <span class="hex">
                  {themes.map((th) => resolve(t.name, th.id)).filter((v, i, a) => a.indexOf(v) === i).join(' · ')}
                </span>
                <p>{t.usage}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>02 · Typography</h2>
      <p class="sub-h">self-hosted variable woff2 · latin + latin-ext · {Object.keys(families).length} families</p>
      {
        typeGroups.map((group) => (
          <div class="type-group">
            <h3>{group.name}</h3>
            {group.note && <p class="muted">{group.note}</p>}
            <div class="type-specimens">
              {group.styles.map((s) => (
                <div>
                  <span class="meta">
                    <b>{s.name}</b> · {families[group.family].split(',')[0].replace(/"/g, '')} {s.fontWeight ?? 400} · {s.fontSize}
                    {s.lineHeight ? ` / ${s.lineHeight}` : ''}
                    {s.letterSpacing ? ` · ${s.letterSpacing}` : ''}
                  </span>
                  <p
                    class="specimen"
                    style={`font-family:${families[group.family]};font-size:${s.fontSize};line-height:${s.lineHeight ?? 1.2};font-weight:${s.fontWeight ?? 400};letter-spacing:${s.letterSpacing ?? 'normal'};font-style:${s.fontStyle ?? 'normal'};${group.family === 'display' ? "font-variation-settings:'SOFT' 100,'WONK' 1;" : ''}`}
                  >
                    {s.sample ?? 'Read the board, set up the perfect turn.'}
                  </p>
                  <p class="use">{s.usage}</p>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="wrap two">
      <div>
        <h2>03 · Spacing, radii, timing</h2>
        <p class="sub-h">8px base · the house curve is ease-out-expo</p>
        {
          (['spacing', 'radius', 'timing', 'easing'] as const).map((fam) => (
            <details class="changelog" open={fam === 'radius'}>
              <summary>{fam}</summary>
              <ul>
                {simple(fam).map((t) => (
                  <li>
                    <code>{t.name}</code> <span class="hex">{t.value}</span> — {t.usage}
                  </li>
                ))}
              </ul>
            </details>
          ))
        }
      </div>

      <div>
        <h2>04 · Interactive elements</h2>
        <p class="sub-h">buttons · pills · telemetry chips · CRT frame</p>

        <div style="display:flex; gap:12px; flex-wrap:wrap; margin-bottom:24px">
          <a class="btn primary" href="#main">▶ Primary CTA</a>
          <a class="btn" href="#main">Secondary action</a>
        </div>

        <div style="margin-bottom:24px">
          <span class="pill play">▶ play on itch.io</span>
          <span class="pill wip">build in progress</span>
          <span class="pill">write-up →</span>
        </div>

        <div class="stat-chips" style="margin-bottom:24px">
          <span class="stat-chip">72 EditMode tests</span>
          <span class="stat-chip">300-seed fairness check</span>
          <span class="stat-chip">25 save invariants</span>
        </div>

        <Figure
          type="image"
          src="/media/push-comes-to-shove/cover.avif"
          alt="Push Comes to Shove key art inside a CRT scanline frame"
          caption="Fig. 1 — .crt-frame specimen with AVIF cover art & scanline overlay"
          ratio="16 / 9"
        />
        <p class="muted" style="margin-top:16px">
          The full component catalogue with live previews and guidelines lives in the Prism CRT design system; this
          page shows the tokens it compiles to.
        </p>
      </div>
    </div>
  </section>
  <section class="section" id="field-kit">
    <div class="wrap">
      <h2>05 · Field kit</h2>
      <p class="sub-h">shared accent kit · src/styles/field-kit.css · each theme from its tokens</p>
      <p class="muted kit-intro">
        Every specimen below is the real class on the real tokens: each block wears one theme through
        <code>data-theme-scope</code>, so a regression in the kit or a theme shows here first.
      </p>
      {
        themes.map((theme) => (
          <div class="kit-theme" data-theme-scope={theme.id}>
            <h3 class="kit-theme-name">{theme.name}</h3>
            <div class="kit-grid">
              <div class="kit-cell">
                <p class="kit-name">.tag · .tag-title · .is-near</p>
                <div class="kit-row">
                  <div class="tag kit-label" style={`--acc:${sample.data.world.accent}`}>
                    <p class="eyebrow">{sampleEyebrow}</p>
                    <p class="tag-title">{sample.data.title}</p>
                  </div>
                  <div class="tag is-near kit-label" style={`--acc:${sample.data.world.accent}`}>
                    <p class="eyebrow">{sampleEyebrow}</p>
                    <p class="tag-title">{sample.data.title}</p>
                  </div>
                </div>
              </div>
              <div class="kit-cell">
                <p class="kit-name">.tag.uncharted</p>
                <div class="tag uncharted kit-label" style={`--acc:${UNCHARTED_ACCENT}`}>
                  <p class="eyebrow">Next project lands here</p>
                  <p class="tag-title">Uncharted</p>
                </div>
              </div>
              <div class="kit-cell">
                <p class="kit-name">.eyebrow · .diamond, every location accent</p>
                <ul class="kit-eyebrows">
                  {eyebrowPlaces.map((row, i) => (
                    <li class="eyebrow" style={`--acc:${row.accent}`}>
                      <i class:list={['diamond', { 'is-done': i % 2 === 0 }]} aria-hidden="true" />
                      {row.name}
                    </li>
                  ))}
                </ul>
              </div>
              <div class="kit-cell">
                <p class="kit-name">.diamond-list</p>
                <ul class="diamond-list" style={`--acc:${sample.data.world.accent}`}>
                  {sample.data.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              </div>
              <div class="kit-cell">
                <p class="kit-name">field log · .hud-panel</p>
                <div class="hud-panel kit-log">
                  <p class="kit-log-head"><span class="meta">Field log</span><span class="meta">2/{logPlaces.length} explored</span></p>
                  <ul>
                    {logPlaces.map((l, i) => (
                      <li style={`--acc:${l.accent}`}>
                        <i class:list={['diamond', { 'is-done': i < 2 }]} aria-hidden="true" />
                        {l.title}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
              <div class="kit-cell">
                <p class="kit-name">.meta-row · .seg · .hud-key</p>
                <p class="meta-row">
                  <span class:list={['pill', sampleView.live ? 'play' : 'wip']}>{sampleView.status}</span><span>{sampleView.period}</span><span>{sample.data.engine}</span>
                </p>
                <div class="seg kit-seg" role="group" aria-label={`Render pass specimen, ${theme.name}`}>
                  {views.map((v, i) => (
                    <button class="key" type="button" aria-pressed={i === 0 ? 'true' : 'false'}>{v}</button>
                  ))}
                </div>
                <div class="kit-row">
                  <a class="btn hud-key" href="#field-kit">Focus token ↑</a>
                  <a class="btn hud-key" href="#field-kit">All projects</a>
                </div>
              </div>
              <div class="kit-cell kit-wide">
                <p class="kit-name">drawer · .accent</p>
                <div class="kit-drawer accent" style={`--acc:${sample.data.world.accent}`}>
                  <p class="eyebrow">{sample.data.genre}</p>
                  <p class="kit-drawer-title">{sample.data.title}</p>
                  <p class="meta-row">
                    <span class="pill">{sampleView.status}</span><span>{sampleView.period}</span><span>{sample.data.engine}</span>
                  </p>
                  <p class="kit-drawer-lead">{sample.data.summary}</p>
                  <ul class="diamond-list">
                    {sample.data.highlights.map((h) => (
                      <li>{h}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        ))
      }
      <h3 class="kit-h">Location accents, measured</h3>
      <p class="muted">
        A location keeps one accent, and the 3D world uses it as it is. The interface tones it for each theme
        first ({accentRules.map((t) => t.name).join(', ')}), then draws the eyebrow (needs {ACCENT_MINIMUM.eyebrow}:1 on
        bg) and the tag border ({ACCENT_MINIMUM.edge}:1). tests/accents.test.ts holds every location to these numbers.
      </p>
      <div class="table-wrap" role="region" aria-label="Location accents" tabindex="0">
        <table>
          <thead>
            <tr>
              <th>Accent</th>
              {themes.map((th) => (
                <th>{th.name}: eyebrow · border</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {accentRows.map((row) => (
              <tr>
                <td>
                  <span class="chip" style={`background:${row.accent}`} /> <code>{row.name}</code> <span class="hex">{row.accent}</span>
                </td>
                {themes.map((th) => {
                  const r = accentRow(row.accent, th.id);
                  return (
                    <td class={r.ok ? 'ok' : 'warn'}>
                      <span class="chip" style={`background:${r.inks.eyebrow}`} /> {r.eyebrow}:1 · <span class="chip" style={`background:${r.inks.edge}`} /> {r.edge}:1
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</Base>

<style>
  .sg-hero {
    position: relative;
    padding: 96px 0 56px;
    overflow: hidden;
  }
  .sg-hero h1 em {
    font-style: italic;
    font-weight: 400;
    color: var(--peach);
  }
  .theme-block {
    margin: 24px 0 40px;
    padding: 20px;
    border-radius: var(--r-md);
    background: var(--bg);
    color: var(--text);
    border: 1px solid var(--umber);
    box-shadow: var(--card-depth);
  }
  .theme-block table {
    font-size: 13px;
  }
  .chip {
    display: inline-block;
    width: 14px;
    height: 14px;
    border-radius: 3px;
    border: 1px solid var(--umber);
    vertical-align: -2px;
    margin-right: 4px;
  }
  .hex {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--gold);
  }
  td.ok {
    color: var(--mint);
    font-family: var(--mono);
    font-size: 12px;
    white-space: nowrap;
  }
  td.warn {
    color: var(--coral);
    font-family: var(--mono);
    font-size: 12px;
    white-space: nowrap;
  }
  td.use,
  p.use {
    color: var(--text-2);
    font-size: 13px;
    max-width: 48ch;
  }
  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: 16px;
    margin-top: 16px;
  }
  .swatch-card {
    background: var(--surface);
    border: 1px solid var(--umber);
    border-radius: var(--r-md);
    overflow: hidden;
    box-shadow: var(--card-depth);
  }
  .swatch-chip {
    height: 64px;
    border-bottom: 1px solid var(--umber);
  }
  .swatch-meta {
    padding: 12px 14px;
  }
  .swatch-meta .hex {
    display: block;
    margin: 4px 0 6px;
  }
  .swatch-meta p {
    font-size: 13px;
    color: var(--text-2);
    margin: 0;
  }
  .type-group {
    margin-top: 28px;
  }
  .type-specimens > div {
    padding: 16px 0;
    border-bottom: var(--line);
  }
  .specimen {
    margin: 6px 0 4px;
    overflow-wrap: anywhere;
  }
  p.use {
    margin: 0;
  }
  details.changelog {
    margin-top: 12px;
  }
  /* ---- 05 · Field kit ---- */
  .kit-intro {
    max-width: 70ch;
  }
  .kit-theme {
    margin: 24px 0 32px;
    padding: 20px;
    border-radius: var(--r-md);
    background: var(--bg);
    color: var(--text);
    border: 1px solid var(--hairline);
  }
  .kit-theme-name {
    margin: 0 0 16px;
  }
  .kit-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px 28px;
  }
  .kit-wide {
    grid-column: 1 / -1;
  }
  .kit-name {
    margin: 0 0 10px;
    font: 500 11px/1.4 var(--font-mono);
    color: var(--text-2);
  }
  .kit-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 12px;
  }
  .kit-row:first-of-type {
    margin-top: 0;
  }
  .kit-label {
    display: inline-block;
    padding: 6px 10px;
  }
  .kit-label p {
    margin: 0;
  }
  .kit-eyebrows {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .kit-eyebrows li {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .kit-cell .diamond-list {
    margin: 0;
    font-size: 14px;
  }
  .kit-log {
    padding: 10px 12px;
  }
  .kit-log-head {
    display: flex;
    justify-content: space-between;
    margin: 0 0 8px;
  }
  .kit-log ul {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 13px;
  }
  .kit-log li {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .kit-seg {
    margin: 12px 0 0;
  }
  /* The map's drawer (world.css .world-drawer) as a still: the accent rule and offset on the left. */
  .kit-drawer {
    max-width: 500px;
    padding: 20px 24px 22px;
    background: var(--bg);
    border-left: 1px solid var(--acc-ui);
    box-shadow: -4px 0 0 color-mix(in srgb, var(--acc-ui) 30%, var(--ink-black));
  }
  .kit-drawer .eyebrow {
    margin: 0 0 6px;
  }
  .kit-drawer-title {
    margin: 0 0 10px;
    font: 600 28px/1.1 var(--font-display);
  }
  .kit-drawer-lead {
    margin: 12px 0;
    color: var(--text-2);
  }
  .kit-h {
    margin-top: 36px;
  }
  /* The tables scroll inside .table-wrap on a phone rather than squeezing their columns to one letter wide. */
  .table-wrap table {
    min-width: 720px;
  }
  /* The accent table's name column: the chip, the name and the hex on one line where it fits. */
  #field-kit td:first-child {
    min-width: 220px;
  }
  @media (max-width: 980px) {
    .kit-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 760px) {
    .kit-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .kit-theme {
      padding: 16px;
    }
  }
  details.changelog li {
    font-size: 14px;
    color: var(--text-2);
  }
</style>

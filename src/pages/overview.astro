---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { PROJECTS_INDEX } from '../data/site';

const projects = (await getCollection('projects')).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99) || a.id.localeCompare(b.id),
);
---

<Base title="Portfolio Overview" description="Complete portfolio overview migrated to the home page." noindex>
  <div class="rail-frame">
    <section class="ac-hero">
      <p class="ac-hero-kicker">UNIFIED PORTFOLIO ROUTE</p>
      <h1>Portfolio Overview</h1>
      <p class="ac-hero-lead">
        All portfolio sections—playable WebGL games, open-source tooling, principles, experience and activities—are now presented together on the home page.
      </p>
      <div class="ac-cta-row">
        <a class="btn primary" href="/">Open Home Page →</a>
        <a class="btn" href={PROJECTS_INDEX}>All 6 Projects</a>
      </div>
    </section>

    <div class="hairline-grid-3">
      {
        projects.map((p, i) => (
          <a class="ac-launcher-tile accent" style={`--acc: ${p.data.world.accent}`} href={`${PROJECTS_INDEX}${p.id}/`}>
            <div class="ac-launcher-top">
              <span class="ac-idx-badge">{String(i + 1).padStart(2, '0')}</span>
              <span>↗</span>
            </div>
            <h2 class="ac-launcher-title">{p.data.title}</h2>
            <span class="ac-launcher-cat">{p.data.category ?? p.data.genre}</span>
          </a>
        ))
      }
    </div>
  </div>
</Base>
